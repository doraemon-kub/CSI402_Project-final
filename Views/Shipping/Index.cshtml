@model List<CSI402_Project_final.Models.Order>
@using CSI402_Project_final.Models
@{
    Layout = "_BackOfficeLayout";
    ViewData["Title"] = "5. จัดการการจัดส่งและพัสดุ (Shipping Staff)";
    int readyToShip = ViewBag.ReadyToShipCount ?? 0;
    int shippedToday = ViewBag.ShippedTodayCount ?? 0;
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">พัสดุรอจัดส่งและบันทึก Tracking</div>
                    <div class="fs-3 fw-bold text-warning">@readyToShip รายการ</div>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-3"><i class="bi bi-box-arrow-up-right"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">จัดส่งแล้ววันนี้</div>
                    <div class="fs-3 fw-bold text-success">@shippedToday รายการ</div>
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-3 fs-3"><i class="bi bi-truck-front-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <h5 class="fw-bold mb-3 text-dark">บันทึกเลขพัสดุ ชั่งน้ำหนักจริง และเปลี่ยนสถานะ (Req 4, 14, 16)</h5>
    
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-box2 fs-1 text-secondary d-block mb-2"></i>
            <h6 class="fw-bold">ยังไม่มีพัสดุที่ต้องจัดส่งในขณะนี้</h6>
            <p class="small text-muted m-0">ออเดอร์จะปรากฏในหน้านี้เมื่อฝ่ายบัญชี (ACC) ตรวจสลิปเรียบร้อย และฝ่ายคำสั่งซื้อ (Order Staff) กดแพ็กของเสร็จแล้ว</p>
        </div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>เลขออเดอร์</th>
                    <th>ผู้รับและที่อยู่</th>
                    <th>นน. ประเมินระบบ</th>
                    <th>นน. ชั่งจริง (kg)</th>
                    <th>บริษัทขนส่ง</th>
                    <th>เลขพัสดุ (Tracking No.)</th>
                    <th>สถานะ</th>
                    <th>การดำเนินการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    bool isDispatched = order.Status == OrderStatus.Shipped && !string.IsNullOrWhiteSpace(order.TrackingNumber);
                    <tr>
                        <td class="fw-bold text-primary text-nowrap">#@order.OrderId</td>
                        <td>
                            <div class="fw-bold text-dark">@order.CustomerName</div>
                            <small class="text-muted d-block text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">@order.ShippingAddress</small>
                        </td>
                        <td class="text-nowrap">
                            <span class="badge @(order.EstimatedWeightKg > 10.0 ? "bg-danger" : "bg-secondary")">
                                ⚖️ @order.EstimatedWeightKg.ToString("0.##") kg
                            </span>
                        </td>

                        @if (isDispatched)
                        {
                            <td class="text-nowrap">
                                <span class="fw-bold text-dark">@((order.ActualWeightKg ?? order.EstimatedWeightKg).ToString("0.##")) kg</span>
                            </td>
                            <td class="text-nowrap">
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-truck text-primary me-1"></i>@(string.IsNullOrWhiteSpace(order.Courier) ? "Flash Express" : order.Courier)
                                </span>
                            </td>
                            <td class="text-nowrap">
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold font-monospace px-2 py-1">
                                    @order.TrackingNumber
                                </span>
                            </td>
                            <td class="text-nowrap">
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>จัดส่งแล้ว</span>
                            </td>
                            <td class="text-nowrap">
                                <span class="text-success small fw-semibold"><i class="bi bi-check2-all me-1"></i>ส่งพัสดุเรียบร้อย</span>
                            </td>
                        }
                        else
                        {
                            string selectedCourier = string.IsNullOrWhiteSpace(order.Courier) ? "Flash Express" : order.Courier;
                            string autoTracking = CSI402_Project_final.Helpers.TrackingHelper.GenerateTrackingNumber(selectedCourier);
                            <td style="min-width: 135px; max-width: 150px;">
                                <form id="shipForm_@order.OrderId" asp-action="DispatchOrder" method="post" class="m-0">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <input type="hidden" name="courier" value="@selectedCourier" />
                                    <input type="hidden" name="role" value="@(ViewContext.HttpContext.Request.Query["role"].FirstOrDefault() ?? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)" />
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" min="0.1" name="actualWeightKg" class="form-control" value="@(order.ActualWeightKg ?? order.EstimatedWeightKg)" placeholder="นน. จริง" required />
                                        <span class="input-group-text">kg</span>
                                    </div>
                                </form>
                            </td>
                            <td class="text-nowrap">
                                <span class="badge bg-light text-dark border px-2 py-1" title="บริษัทขนส่งที่ลูกค้าเลือกตอนสั่งซื้อ">
                                    <i class="bi bi-truck text-primary me-1"></i>@selectedCourier
                                </span>
                            </td>
                            <td style="min-width: 220px;">
                                <div class="input-group input-group-sm">
                                    <input type="text" name="trackingNumber" id="trackInput_@order.OrderId" form="shipForm_@order.OrderId" class="form-control form-control-sm font-monospace fw-bold text-dark" value="@autoTracking" required />
                                    <button type="button" class="btn btn-outline-secondary" title="สุ่มเลข Tracking ใหม่" onclick="regenerateTracking('@order.OrderId', '@selectedCourier')">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                                <div class="text-success" style="font-size: 0.68rem; margin-top: 2px;">
                                    <i class="bi bi-magic me-1"></i>ระบบสุ่มเจนเลขพัสดุจำลองให้แล้ว
                                </div>
                            </td>
                            <td class="text-nowrap">
                                <span class="badge bg-warning text-dark"><i class="bi bi-box-seam me-1"></i>พร้อมส่ง</span>
                            </td>
                            <td class="text-nowrap">
                                <button type="submit" form="shipForm_@order.OrderId" class="btn btn-sm btn-primary fw-bold px-3">
                                    <i class="bi bi-send me-1"></i> ส่งพัสดุ
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

@section Scripts {
    <script>
        function regenerateTracking(orderId, courier) {
            const input = document.getElementById('trackInput_' + orderId);
            if (!input) return;
            const rndNum = Math.floor(100000000 + Math.random() * 900000000);
            const c = (courier || '').toLowerCase();
            if (c.includes('kerry')) {
                input.value = 'KRY' + rndNum + 'TH';
            } else if (c.includes('ems') || c.includes('post') || c.includes('ไปรษณีย์')) {
                input.value = 'ED' + rndNum + 'TH';
            } else {
                const extra = Math.floor(10 + Math.random() * 90);
                input.value = 'TH' + rndNum.toString() + extra + 'F';
            }
        }
    </script>
}
