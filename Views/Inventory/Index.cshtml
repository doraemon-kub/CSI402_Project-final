@model List<CSI402_Project_final.Models.Product>
@using CSI402_Project_final.Models
@{
    Layout = "_BackOfficeLayout";
    ViewData["Title"] = "3. ระบบจัดการสินค้าและสต็อก (Inventory Staff)";
    int lowStock = ViewBag.LowStockCount ?? 0;
    int outOfStock = ViewBag.OutOfStockCount ?? 0;
}

<!-- Summary Alert Cards (Req 18: ระบบแจ้งเตือนเมื่อสินค้าต่ำกว่าระดับที่กำหนด) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">สินค้าทั้งหมดในคลัง</div>
                    <div class="fs-3 fw-bold text-dark">@Model.Count SKU</div>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3"><i class="bi bi-boxes"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 @(lowStock > 0 ? "bg-warning-subtle border border-warning" : "bg-white")">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold">⚠️ แจ้งเตือน: สต็อกต่ำกว่าเกณฑ์ (Low Stock)</div>
                    <div class="fs-3 fw-bold text-warning">@lowStock รายการ</div>
                </div>
                <div class="p-3 bg-warning text-dark rounded-3 fs-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 @(outOfStock > 0 ? "bg-danger-subtle border border-danger" : "bg-white")">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-bold">❌ สินค้าหมดสต็อก (Out of Stock)</div>
                    <div class="fs-3 fw-bold text-danger">@outOfStock รายการ</div>
                </div>
                <div class="p-3 bg-danger text-white rounded-3 fs-3"><i class="bi bi-x-octagon-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Header Actions -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold m-0 text-dark">ตารางข้อมูลสินค้าและระดับสต็อก (Req 6, 17, 18)</h5>
        <button type="button" class="btn btn-primary" onclick="openCreateProductModal()">
            <i class="bi bi-plus-circle me-1"></i> เพิ่มสินค้าใหม่เข้าระบบ
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>รหัส</th>
                    <th>สินค้า</th>
                    <th>ประเภท/หมวด</th>
                    <th>น้ำหนัก (kg)</th>
                    <th>ราคาปกติ / พิเศษ</th>
                    <th>สต็อกคงเหลือ</th>
                    <th>เกณฑ์เตือน</th>
                    <th>สถานะ</th>
                    <th>ปรับสต็อก</th>
                    <th>จัดการ (Req 6, 17)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsOutOfStock ? "table-danger" : item.IsLowStock ? "table-warning" : "")">
                        <td class="fw-bold">#@item.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.ImageUrl" class="rounded-2" style="width: 45px; height: 45px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted">แบรนด์: @item.Brand | ช่วงวัย: @item.AgeStage | สูตร: @item.SpecialNeed</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @(item.PetType == PetCategory.Dog ? "สุนัข" : item.PetType == PetCategory.Cat ? "แมว" : "สัตว์เลี้ยงอื่นๆ") / @item.Category
                            </span>
                        </td>
                        <td><strong>⚖️ @item.WeightKg kg</strong></td>
                        <td>
                            <div class="fw-bold">฿@item.Price.ToString("N0")</div>
                            @if (item.SpecialDiscountPrice.HasValue)
                            {
                                <small class="text-danger fw-semibold">ลดเหลือ ฿@item.SpecialDiscountPrice.Value.ToString("N0")</small>
                            }
                        </td>
                        <td>
                            <span class="fs-6 fw-bold @(item.IsOutOfStock ? "text-danger" : item.IsLowStock ? "text-warning" : "text-success")">
                                @item.StockQuantity ชิ้น
                            </span>
                        </td>
                        <td><small class="text-muted">@item.LowStockThreshold ชิ้น</small></td>
                        <td>
                            @if (item.IsOutOfStock)
                            {
                                <span class="badge bg-danger">หมดสต็อก</span>
                            }
                            else if (item.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark">ใกล้หมด!</span>
                            }
                            else
                            {
                                <span class="badge bg-success">ปกติ</span>
                            }
                        </td>
                        <td>
                            <form asp-action="UpdateStock" method="post" class="d-flex gap-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" name="adjustment" value="-1" class="btn btn-sm btn-outline-danger px-2">-1</button>
                                <button type="submit" name="adjustment" value="5" class="btn btn-sm btn-outline-success px-2">+5</button>
                            </form>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        title="แก้ไขข้อมูลสินค้า"
                                        onclick="openEditProductModal(this)"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-brand="@item.Brand"
                                        data-pettype="@item.PetType"
                                        data-category="@item.Category"
                                        data-agestage="@item.AgeStage"
                                        data-weight="@item.WeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-discount="@(item.SpecialDiscountPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                        data-stock="@item.StockQuantity"
                                        data-threshold="@item.LowStockThreshold"
                                        data-specialneed="@item.SpecialNeed"
                                        data-imageurl="@item.ImageUrl"
                                        data-description="@item.Description">
                                    <i class="bi bi-pencil-square"></i> แก้ไข
                                </button>
                                <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('ยืนยันลบสินค้านี้?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="ลบสินค้า">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal เพิ่ม / แก้ไขข้อมูลสินค้า (Req 6, 17) -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="SaveProduct" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Id" id="prodId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="productModalTitle">เพิ่มสินค้าใหม่เข้าคลังสินค้า</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">ชื่อสินค้า</label>
                        <input type="text" name="Name" id="prodName" class="form-control" required placeholder="เช่น Royal Canin Maxi Puppy" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">แบรนด์สินค้า</label>
                        <input type="text" name="Brand" id="prodBrand" class="form-control" required placeholder="เช่น Royal Canin" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">สัตว์เลี้ยง (Req 1)</label>
                        <select name="PetType" id="prodPetType" class="form-select">
                            <option value="@PetCategory.Dog">🐶 สุนัข</option>
                            <option value="@PetCategory.Cat">🐱 แมว</option>
                            <option value="@PetCategory.Other">🐾 สัตว์เลี้ยงอื่นๆ</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">หมวดหมู่</label>
                        <select name="Category" id="prodCategory" class="form-select">
                            <option value="@ProductCategory.Food">🍲 อาหาร</option>
                            <option value="@ProductCategory.Supply">🧸 ของใช้</option>
                            <option value="@ProductCategory.Hygiene">🧼 สุขอนามัย</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">ช่วงวัย (Layer)</label>
                        <select name="AgeStage" id="prodAgeStage" class="form-select">
                            <option value="@AgeStage.PuppyOrKitten">🍼 วัยเด็ก (ลูกสุนัข/ลูกแมว)</option>
                            <option value="@AgeStage.Adult">🐕 โตเต็มวัย (Adult)</option>
                            <option value="@AgeStage.Senior">🧓 สูงวัย (Senior)</option>
                            <option value="@AgeStage.AllAges">🐾 ทุกช่วงวัย</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">น้ำหนักสินค้า (kg)</label>
                        <input type="number" step="0.1" name="WeightKg" id="prodWeight" class="form-control" value="1.0" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">ราคาปกติ (บาท)</label>
                        <input type="number" step="0.01" name="Price" id="prodPrice" class="form-control" value="500" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">ราคาลดพิเศษ (ถ้ามี)</label>
                        <input type="number" step="0.01" name="SpecialDiscountPrice" id="prodDiscount" class="form-control" placeholder="ไม่บังคับ" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">สูตรเฉพาะ / โรคประจำตัว</label>
                        <input type="text" name="SpecialNeed" id="prodSpecialNeed" list="specialNeedList" class="form-control" value="ทั่วไป" required />
                        <datalist id="specialNeedList">
                            <option value="ทั่วไป" />
                            <option value="โรคไต" />
                            <option value="บำรุงขน" />
                            <option value="เสริมสร้างกระดูก" />
                            <option value="บำรุงสมองและสายตา" />
                            <option value="สุขอนามัย" />
                        </datalist>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">จำนวนสต็อก</label>
                        <input type="number" name="StockQuantity" id="prodStock" class="form-control" value="20" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">เกณฑ์เตือนสต็อกต่ำ</label>
                        <input type="number" name="LowStockThreshold" id="prodThreshold" class="form-control" value="5" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">อัปโหลดรูปสินค้า (ไม่เกิน 5MB)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold">หรือระบุลิงก์รูปภาพ (Image URL)</label>
                        <input type="text" name="ImageUrl" id="prodImageUrl" class="form-control" placeholder="https://... (ถ้าอัปโหลดไฟล์ด้านบนจะใช้ไฟล์ที่อัปโหลดแทน)" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold">คำอธิบายสินค้า</label>
                        <textarea name="Description" id="prodDescription" class="form-control" rows="2" placeholder="รายละเอียดคุณค่าทางอาหารและคุณสมบัติ"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary" id="productModalSubmit">บันทึกสินค้า</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getProductModal() {
            return bootstrap.Modal.getOrCreateInstance(document.getElementById('productModal'));
        }

        function openCreateProductModal() {
            document.getElementById('productModalTitle').innerText = 'เพิ่มสินค้าใหม่เข้าคลังสินค้า';
            document.getElementById('productModalSubmit').innerText = 'บันทึกสินค้าใหม่';
            document.getElementById('prodId').value = '0';
            document.getElementById('prodName').value = '';
            document.getElementById('prodBrand').value = '';
            document.getElementById('prodPetType').value = 'Dog';
            document.getElementById('prodCategory').value = 'Food';
            document.getElementById('prodAgeStage').value = 'AllAges';
            document.getElementById('prodWeight').value = '1.0';
            document.getElementById('prodPrice').value = '500';
            document.getElementById('prodDiscount').value = '';
            document.getElementById('prodStock').value = '20';
            document.getElementById('prodThreshold').value = '5';
            document.getElementById('prodSpecialNeed').value = 'ทั่วไป';
            document.getElementById('prodImageUrl').value = '';
            document.getElementById('prodDescription').value = '';
            getProductModal().show();
        }

        function openEditProductModal(btn) {
            document.getElementById('productModalTitle').innerText = 'แก้ไขข้อมูลสินค้า #' + btn.dataset.id;
            document.getElementById('productModalSubmit').innerText = 'บันทึกการแก้ไข';
            document.getElementById('prodId').value = btn.dataset.id;
            document.getElementById('prodName').value = btn.dataset.name;
            document.getElementById('prodBrand').value = btn.dataset.brand;
            document.getElementById('prodPetType').value = btn.dataset.pettype;
            document.getElementById('prodCategory').value = btn.dataset.category;
            document.getElementById('prodAgeStage').value = btn.dataset.agestage;
            document.getElementById('prodWeight').value = btn.dataset.weight;
            document.getElementById('prodPrice').value = btn.dataset.price;
            document.getElementById('prodDiscount').value = btn.dataset.discount;
            document.getElementById('prodStock').value = btn.dataset.stock;
            document.getElementById('prodThreshold').value = btn.dataset.threshold;
            document.getElementById('prodSpecialNeed').value = btn.dataset.specialneed || 'ทั่วไป';
            document.getElementById('prodImageUrl').value = btn.dataset.imageurl || '';
            document.getElementById('prodDescription').value = btn.dataset.description || '';
            getProductModal().show();
        }
    </script>
}
