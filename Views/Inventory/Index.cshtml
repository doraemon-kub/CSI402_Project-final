@model List<CSI402_Project_final.Models.Product>
@using CSI402_Project_final.Models
@{
    Layout = "_BackOfficeLayout";
    ViewData["Title"] = "3. ระบบจัดการสินค้าและสต็อก (Inventory Staff)";
    int totalProducts = ViewBag.TotalProducts ?? Model.Count;
    int lowStock = ViewBag.LowStockCount ?? 0;
    int outOfStock = ViewBag.OutOfStockCount ?? 0;
    int normalStock = ViewBag.NormalStockCount ?? 0;
    int foodCount = ViewBag.FoodCount ?? 0;
    int supplyCount = ViewBag.SupplyCount ?? 0;
    int hygieneCount = ViewBag.HygieneCount ?? 0;
    string stockFilter = ViewBag.StockFilter as string ?? "all";
    string categoryFilter = ViewBag.CategoryFilter as string ?? "all";
    string? search = ViewBag.Search as string;
}

<!-- Summary Alert Cards (Clickable Filter Cards — Req 18) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-action="Index" asp-route-stockFilter="all" asp-route-search="@search" class="text-decoration-none d-block">
            <div class="card p-3 bg-white h-100" style="transition: transform 0.2s, box-shadow 0.2s; @(stockFilter == "all" ? "border: 2px solid var(--lux-espresso) !important; box-shadow: 0 8px 20px rgba(35,29,25,0.1) !important;" : "")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-lux-muted small fw-medium">สินค้าทั้งหมดในคลัง</div>
                        <div class="fs-3 fw-bold text-lux-espresso">@totalProducts SKU</div>
                        <div class="small text-lux-muted" style="font-size: 0.72rem;">คลิกเพื่อแสดงสินค้าทั้งหมด</div>
                    </div>
                    <div class="p-3 rounded-3 fs-3" style="background: var(--lux-gold-soft); color: var(--lux-gold-dark);">
                        <i class="bi bi-boxes"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Index" asp-route-stockFilter="low" asp-route-search="@search" class="text-decoration-none d-block">
            <div class="card p-3 h-100 @(lowStock > 0 ? "bg-warning-subtle" : "bg-white")" style="transition: transform 0.2s, box-shadow 0.2s; @(stockFilter == "low" ? "border: 2px solid var(--lux-warning) !important; box-shadow: 0 8px 20px rgba(154,100,20,0.16) !important;" : "")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold" style="color: var(--lux-warning);">⚠️ สต็อกต่ำกว่าเกณฑ์ (Low Stock)</div>
                        <div class="fs-3 fw-bold" style="color: var(--lux-warning);">@lowStock รายการ</div>
                        <div class="small text-lux-muted" style="font-size: 0.72rem;">คลิกเพื่อกรองสินค้าใกล้หมด</div>
                    </div>
                    <div class="p-3 rounded-3 fs-3" style="background: #F6DC9D; color: #7C4F0C;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Index" asp-route-stockFilter="out" asp-route-search="@search" class="text-decoration-none d-block">
            <div class="card p-3 h-100 @(outOfStock > 0 ? "bg-danger-subtle" : "bg-white")" style="transition: transform 0.2s, box-shadow 0.2s; @(stockFilter == "out" ? "border: 2px solid var(--lux-danger) !important; box-shadow: 0 8px 20px rgba(180,62,50,0.16) !important;" : "")">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small fw-semibold" style="color: var(--lux-danger);">❌ สินค้าหมดสต็อก (Out of Stock)</div>
                        <div class="fs-3 fw-bold" style="color: var(--lux-danger);">@outOfStock รายการ</div>
                        <div class="small text-lux-muted" style="font-size: 0.72rem;">คลิกเพื่อกรองสินค้าหมดสต็อก</div>
                    </div>
                    <div class="p-3 rounded-3 fs-3 text-white" style="background: var(--lux-danger);">
                        <i class="bi bi-x-octagon-fill"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Header Actions & Stock Filter Bar -->
<div class="card p-4 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <h5 class="fw-bold m-0 text-lux-espresso">ตารางข้อมูลสินค้าและระดับสต็อก (Req 6, 17, 18)</h5>
            <small class="text-lux-muted">กำลังแสดง @Model.Count จากทั้งหมด @totalProducts รายการ</small>
        </div>
        <button type="button" class="btn btn-primary px-3 py-2" onclick="openCreateProductModal()">
            <i class="bi bi-plus-circle me-1"></i> เพิ่มสินค้าใหม่เข้าระบบ
        </button>
    </div>

    <!-- Filter Pills & Search -->
    <div class="d-flex flex-column gap-3 p-3 rounded-3 mb-4 bg-lux-tint" style="border: 1px solid var(--lux-border);">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-stretch align-items-lg-center gap-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small fw-semibold text-lux-muted me-1"><i class="bi bi-funnel me-1"></i>กรองสถานะ:</span>
                <a asp-action="Index" asp-route-stockFilter="all" asp-route-categoryFilter="@categoryFilter" asp-route-search="@search"
                   class="btn btn-sm rounded-pill px-3 @(stockFilter == "all" ? "btn-pet-primary" : "btn-lux-outline")">
                    ทั้งหมด (@totalProducts)
                </a>
                <a asp-action="Index" asp-route-stockFilter="low" asp-route-categoryFilter="@categoryFilter" asp-route-search="@search"
                   class="btn btn-sm rounded-pill px-3 @(stockFilter == "low" ? "btn-warning text-dark fw-semibold" : "btn-lux-outline")">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Low Stock (@lowStock)
                </a>
                <a asp-action="Index" asp-route-stockFilter="out" asp-route-categoryFilter="@categoryFilter" asp-route-search="@search"
                   class="btn btn-sm rounded-pill px-3 @(stockFilter == "out" ? "btn-danger fw-semibold" : "btn-lux-outline")">
                    <i class="bi bi-x-octagon-fill me-1"></i> Out of Stock (@outOfStock)
                </a>
                <a asp-action="Index" asp-route-stockFilter="normal" asp-route-categoryFilter="@categoryFilter" asp-route-search="@search"
                   class="btn btn-sm rounded-pill px-3 @(stockFilter == "normal" ? "btn-success fw-semibold" : "btn-lux-outline")">
                    <i class="bi bi-check-circle-fill me-1"></i> สต็อกปกติ (@normalStock)
                </a>
            </div>

            <form method="get" asp-action="Index" class="d-flex gap-2" style="min-width: 260px;">
                <input type="hidden" name="stockFilter" value="@stockFilter" />
                <input type="hidden" name="categoryFilter" value="@categoryFilter" />
                <input type="text" name="search" value="@search" class="form-control form-control-sm" placeholder="ค้นหาชื่อสินค้า / ของใช้ / แบรนด์..." />
                <button type="submit" class="btn btn-sm btn-pet-primary px-3 flex-shrink-0">
                    <i class="bi bi-search"></i>
                </button>
                @if (!string.IsNullOrWhiteSpace(search) || stockFilter != "all" || categoryFilter != "all")
                {
                    <a asp-action="Index" class="btn btn-sm btn-lux-outline px-2 flex-shrink-0" title="ล้างตัวกรอง">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </form>
        </div>

        <!-- Category Filter Pills (FR-02: อาหาร / ของใช้สัตว์เลี้ยง / สุขอนามัย) -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-2" style="border-top: 1px dashed var(--lux-border);">
            <span class="small fw-semibold text-lux-muted me-1"><i class="bi bi-tags me-1"></i>กรองหมวดหมู่:</span>
            <a asp-action="Index" asp-route-stockFilter="@stockFilter" asp-route-categoryFilter="all" asp-route-search="@search"
               class="btn btn-sm rounded-pill px-3 @(string.Equals(categoryFilter, "all", StringComparison.OrdinalIgnoreCase) ? "btn-dark text-white" : "btn-lux-outline")">
                ทุกหมวดหมู่ (@totalProducts)
            </a>
            <a asp-action="Index" asp-route-stockFilter="@stockFilter" asp-route-categoryFilter="Food" asp-route-search="@search"
               class="btn btn-sm rounded-pill px-3 @(string.Equals(categoryFilter, "Food", StringComparison.OrdinalIgnoreCase) ? "btn-primary text-white fw-semibold" : "btn-lux-outline")">
                🍲 อาหารและขนม (@foodCount)
            </a>
            <a asp-action="Index" asp-route-stockFilter="@stockFilter" asp-route-categoryFilter="Supply" asp-route-search="@search"
               class="btn btn-sm rounded-pill px-3 @(string.Equals(categoryFilter, "Supply", StringComparison.OrdinalIgnoreCase) ? "btn-success text-white fw-semibold" : "btn-lux-outline")">
                🧸 ของใช้และอุปกรณ์สัตว์เลี้ยง (@supplyCount)
            </a>
            <a asp-action="Index" asp-route-stockFilter="@stockFilter" asp-route-categoryFilter="Hygiene" asp-route-search="@search"
               class="btn btn-sm rounded-pill px-3 @(string.Equals(categoryFilter, "Hygiene", StringComparison.OrdinalIgnoreCase) ? "btn-info text-dark fw-semibold" : "btn-lux-outline")">
                🧼 สุขอนามัยและทรายแมว (@hygieneCount)
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox text-lux-gold" style="font-size: 2.5rem;"></i>
            <h6 class="mt-3 fw-semibold text-lux-espresso">ไม่พบรายการสินค้าในเงื่อนไขที่เลือก</h6>
            <p class="small text-lux-muted mb-3">
                @(stockFilter == "low" ? "ยอดเยี่ยม! ขณะนี้ไม่มีสินค้าที่สต็อกต่ำกว่าเกณฑ์" :
                  stockFilter == "out" ? "ยอดเยี่ยม! ขณะนี้ไม่มีสินค้าที่หมดสต็อก" :
                  "ลองเปลี่ยนคำค้นหาหรือเลือกดูสินค้าทั้งหมด")
            </p>
            <a asp-action="Index" class="btn btn-sm btn-lux-outline px-3">แสดงสินค้าทั้งหมด</a>
        </div>
    }
    else
    {
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>รหัส</th>
                    <th>สินค้า</th>
                    <th>ประเภท/หมวด</th>
                    <th>น้ำหนัก (kg)</th>
                    <th>ราคาปกติ / พิเศษ</th>
                    <th>สต็อกคงเหลือ</th>
                    <th>เกณฑ์เตือน</th>
                    <th>สถานะ</th>
                    <th>ปรับสต็อก</th>
                    <th>จัดการ (Req 6, 17)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.IsOutOfStock ? "table-danger" : item.IsLowStock ? "table-warning" : "")">
                        <td class="fw-bold">#@item.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@item.ImageUrl" class="rounded-2 bg-white border p-1" style="width: 48px; height: 48px; object-fit: contain;" />
                                <div>
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <small class="text-muted">แบรนด์: @item.Brand | ช่วงวัย: @item.AgeStage | สูตร: @item.SpecialNeed</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-column gap-1">
                                <span class="badge bg-light text-dark border">
                                    @(item.PetType == PetCategory.Dog ? "🐶 สุนัข" : item.PetType == PetCategory.Cat ? "🐱 แมว" : "🐾 สัตว์เลี้ยงอื่นๆ")
                                </span>
                                <span class="badge @(item.Category == ProductCategory.Supply ? "bg-success-subtle text-success" : item.Category == ProductCategory.Hygiene ? "bg-info-subtle text-info-emphasis" : "bg-warning-subtle text-dark")">
                                    @(item.Category == ProductCategory.Food ? "🍲 อาหาร" : item.Category == ProductCategory.Supply ? "🧸 ของใช้สัตว์เลี้ยง" : "🧼 สุขอนามัย")
                                </span>
                            </div>
                        </td>
                        <td><strong>⚖️ @item.WeightKg kg</strong></td>
                        <td>
                            <div class="fw-bold">฿@item.Price.ToString("N0")</div>
                            @if (item.SpecialDiscountPrice.HasValue)
                            {
                                <small class="text-danger fw-semibold">ลดเหลือ ฿@item.SpecialDiscountPrice.Value.ToString("N0")</small>
                            }
                        </td>
                        <td>
                            <span class="fs-6 fw-bold @(item.IsOutOfStock ? "text-danger" : item.IsLowStock ? "text-warning" : "text-success")">
                                @item.StockQuantity ชิ้น
                            </span>
                        </td>
                        <td><small class="text-muted">@item.LowStockThreshold ชิ้น</small></td>
                        <td>
                            @if (item.IsOutOfStock)
                            {
                                <span class="badge bg-danger">หมดสต็อก</span>
                            }
                            else if (item.IsLowStock)
                            {
                                <span class="badge bg-warning text-dark">ใกล้หมด!</span>
                            }
                            else
                            {
                                <span class="badge bg-success">ปกติ</span>
                            }
                        </td>
                        <td>
                            <form asp-action="UpdateStock" method="post" class="d-flex gap-1">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="stockFilter" value="@stockFilter" />
                                <input type="hidden" name="categoryFilter" value="@categoryFilter" />
                                <input type="hidden" name="search" value="@search" />
                                <button type="submit" name="adjustment" value="-1" class="btn btn-sm btn-outline-danger px-2">-1</button>
                                <button type="submit" name="adjustment" value="5" class="btn btn-sm btn-outline-success px-2">+5</button>
                            </form>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        title="แก้ไขข้อมูลสินค้า"
                                        onclick="openEditProductModal(this)"
                                        data-id="@item.Id"
                                        data-name="@item.Name"
                                        data-brand="@item.Brand"
                                        data-pettype="@item.PetType"
                                        data-category="@item.Category"
                                        data-agestage="@item.AgeStage"
                                        data-weight="@item.WeightKg.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-price="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-discount="@(item.SpecialDiscountPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                        data-stock="@item.StockQuantity"
                                        data-threshold="@item.LowStockThreshold"
                                        data-specialneed="@item.SpecialNeed"
                                        data-imageurl="@item.ImageUrl"
                                        data-description="@item.Description">
                                    <i class="bi bi-pencil-square"></i> แก้ไข
                                </button>
                                <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('ยืนยันลบสินค้านี้?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="ลบสินค้า">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    }
</div>

<!-- Modal เพิ่ม / แก้ไขข้อมูลสินค้า (Req 6, 17) -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="SaveProduct" asp-route-role="@ViewBag.CurrentRole" method="post" enctype="multipart/form-data">
                <input type="hidden" name="role" value="@ViewBag.CurrentRole" />
                <input type="hidden" name="Id" id="prodId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="productModalTitle">เพิ่มสินค้าใหม่เข้าคลังสินค้า</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">ชื่อสินค้า</label>
                        <input type="text" name="Name" id="prodName" class="form-control" required placeholder="เช่น Royal Canin Maxi Puppy" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">แบรนด์สินค้า</label>
                        <input type="text" name="Brand" id="prodBrand" class="form-control" required placeholder="เช่น Royal Canin" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">สัตว์เลี้ยง (Req 1)</label>
                        <select name="PetType" id="prodPetType" class="form-select">
                            <option value="@PetCategory.Dog">🐶 สุนัข</option>
                            <option value="@PetCategory.Cat">🐱 แมว</option>
                            <option value="@PetCategory.Other">🐾 สัตว์เลี้ยงอื่นๆ</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">หมวดหมู่</label>
                        <select name="Category" id="prodCategory" class="form-select">
                            <option value="@ProductCategory.Food">🍲 อาหาร</option>
                            <option value="@ProductCategory.Supply">🧸 ของใช้</option>
                            <option value="@ProductCategory.Hygiene">🧼 สุขอนามัย</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">ช่วงวัย (Layer)</label>
                        <select name="AgeStage" id="prodAgeStage" class="form-select">
                            <option value="@AgeStage.PuppyOrKitten">🍼 วัยเด็ก (ลูกสุนัข/ลูกแมว)</option>
                            <option value="@AgeStage.Adult">🐕 โตเต็มวัย (Adult)</option>
                            <option value="@AgeStage.Senior">🧓 สูงวัย (Senior)</option>
                            <option value="@AgeStage.AllAges">🐾 ทุกช่วงวัย</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">น้ำหนักสินค้า (kg)</label>
                        <input type="number" step="0.1" name="WeightKg" id="prodWeight" class="form-control" value="1.0" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">ราคาปกติ (บาท)</label>
                        <input type="number" step="0.01" name="Price" id="prodPrice" class="form-control" value="500" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">ราคาลดพิเศษ (ถ้ามี)</label>
                        <input type="number" step="0.01" name="SpecialDiscountPrice" id="prodDiscount" class="form-control" placeholder="ไม่บังคับ" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">ประเภทของใช้ / สูตรเฉพาะ</label>
                        <input type="text" name="SpecialNeed" id="prodSpecialNeed" list="specialNeedList" class="form-control" value="ทั่วไป" required />
                        <datalist id="specialNeedList">
                            <option value="ทั่วไป" />
                            <option value="อุปกรณ์การกินและน้ำ" />
                            <option value="ของเล่นเสริมพัฒนาการ" />
                            <option value="สายจูงและเดินทาง" />
                            <option value="เสื้อผ้าและแฟชั่น" />
                            <option value="สุขอนามัย" />
                            <option value="โรคไต" />
                            <option value="บำรุงขนและผิวหนัง" />
                            <option value="เสริมสร้างกระดูก" />
                            <option value="เสริมข้อต่อกระดูก" />
                            <option value="บำรุงสมองและสายตา" />
                        </datalist>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">จำนวนสต็อก</label>
                        <input type="number" name="StockQuantity" id="prodStock" class="form-control" value="20" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">เกณฑ์เตือนสต็อกต่ำ</label>
                        <input type="number" name="LowStockThreshold" id="prodThreshold" class="form-control" value="5" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">อัปโหลดรูปสินค้า (ไม่เกิน 5MB)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold">หรือระบุลิงก์รูปภาพ (Image URL)</label>
                        <input type="text" name="ImageUrl" id="prodImageUrl" class="form-control" placeholder="https://... (ถ้าอัปโหลดไฟล์ด้านบนจะใช้ไฟล์ที่อัปโหลดแทน)" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold">คำอธิบายสินค้า</label>
                        <textarea name="Description" id="prodDescription" class="form-control" rows="2" placeholder="รายละเอียดคุณค่าทางอาหารและคุณสมบัติ"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-primary" id="productModalSubmit">บันทึกสินค้า</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getProductModal() {
            return bootstrap.Modal.getOrCreateInstance(document.getElementById('productModal'));
        }

        function openCreateProductModal() {
            document.getElementById('productModalTitle').innerText = 'เพิ่มสินค้าใหม่เข้าคลังสินค้า';
            document.getElementById('productModalSubmit').innerText = 'บันทึกสินค้าใหม่';
            document.getElementById('prodId').value = '0';
            document.getElementById('prodName').value = '';
            document.getElementById('prodBrand').value = '';
            document.getElementById('prodPetType').value = 'Dog';
            document.getElementById('prodCategory').value = 'Food';
            document.getElementById('prodAgeStage').value = 'AllAges';
            document.getElementById('prodWeight').value = '1.0';
            document.getElementById('prodPrice').value = '500';
            document.getElementById('prodDiscount').value = '';
            document.getElementById('prodStock').value = '20';
            document.getElementById('prodThreshold').value = '5';
            document.getElementById('prodSpecialNeed').value = 'ทั่วไป';
            document.getElementById('prodImageUrl').value = '';
            document.getElementById('prodDescription').value = '';
            getProductModal().show();
        }

        function openEditProductModal(btn) {
            document.getElementById('productModalTitle').innerText = 'แก้ไขข้อมูลสินค้า #' + btn.dataset.id;
            document.getElementById('productModalSubmit').innerText = 'บันทึกการแก้ไข';
            document.getElementById('prodId').value = btn.dataset.id;
            document.getElementById('prodName').value = btn.dataset.name;
            document.getElementById('prodBrand').value = btn.dataset.brand;
            document.getElementById('prodPetType').value = btn.dataset.pettype;
            document.getElementById('prodCategory').value = btn.dataset.category;
            document.getElementById('prodAgeStage').value = btn.dataset.agestage;
            document.getElementById('prodWeight').value = btn.dataset.weight;
            document.getElementById('prodPrice').value = btn.dataset.price;
            document.getElementById('prodDiscount').value = btn.dataset.discount;
            document.getElementById('prodStock').value = btn.dataset.stock;
            document.getElementById('prodThreshold').value = btn.dataset.threshold;
            document.getElementById('prodSpecialNeed').value = btn.dataset.specialneed || 'ทั่วไป';
            document.getElementById('prodImageUrl').value = btn.dataset.imageurl || '';
            document.getElementById('prodDescription').value = btn.dataset.description || '';
            getProductModal().show();
        }

        document.addEventListener("DOMContentLoaded", function () {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('openCreate') === 'true') {
                openCreateProductModal();
            } else if (urlParams.get('editId')) {
                const editId = urlParams.get('editId');
                const editBtn = document.querySelector(`button[data-id="${editId}"]`);
                if (editBtn) {
                    openEditProductModal(editBtn);
                }
            }
        });
    </script>
}
