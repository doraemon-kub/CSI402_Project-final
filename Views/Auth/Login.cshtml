@model CSI402_Project_final.Models.LoginViewModel
@using CSI402_Project_final.Models
@{
    ViewData["Title"] = "เข้าสู่ระบบ - PetStore Pro";
    var demoUsers = ViewBag.AllDemoUsers as List<SystemUser> ?? new();
}

<div class="container pt-3 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <!-- Luxury Minimalist Login Card -->
            <div class="lux-card overflow-hidden mb-4" style="box-shadow: var(--lux-shadow-lg);">
                <div class="p-4 p-md-5 text-center" style="background: linear-gradient(135deg, #231D19, #382D25); color: #FAF8F5;">
                    <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center mb-3"
                         style="width: 56px; height: 56px; background: rgba(223, 195, 168, 0.14); border: 1px solid rgba(223, 195, 168, 0.3); color: var(--lux-gold-light);">
                        <i class="bi bi-person fs-3"></i>
                    </div>
                    <h4 class="font-serif-brand fw-bold mb-1">Welcome Back</h4>
                    <p class="small mb-0" style="color: #CFC6BC;">เข้าสู่ระบบ PetStore Pro เพื่อสั่งซื้อสินค้าหรือจัดการระบบตามบทบาท</p>
                </div>

                <div class="p-4 p-md-5">
                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger rounded-3 py-2 small mb-4" role="alert">
                            <div asp-validation-summary="All" class="m-0"></div>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label class="form-label small fw-medium text-lux-muted">ชื่อผู้ใช้หรืออีเมล</label>
                            <div class="input-group">
                                <span class="input-group-text border-end-0"><i class="bi bi-person"></i></span>
                                <input asp-for="Username" class="form-control border-start-0" placeholder="เช่น customer, inventory, owner..." />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <label class="form-label small fw-medium text-lux-muted">รหัสผ่าน</label>
                                <a href="#" class="small text-decoration-none text-lux-muted">ลืมรหัสผ่าน?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text border-end-0"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0" placeholder="รหัสผ่าน (ทุกบทบาทใช้ 123456)" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-lux-muted">จดจำการเข้าสู่ระบบ</label>
                        </div>

                        <button type="submit" class="btn btn-pet-primary w-100 py-3 fw-medium mb-3">
                            <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ
                        </button>

                        <div class="text-center small text-lux-muted">
                            ยังไม่มีบัญชีสมาชิก? <a asp-action="Register" class="text-lux-gold fw-semibold text-decoration-none">สมัครสมาชิกใหม่</a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Quick Demo Login Card -->
            <div class="lux-card p-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="lux-tag lux-tag-accent"><i class="bi bi-lightning-charge-fill me-1"></i>Fast Switch</span>
                    <h6 class="fw-bold m-0 text-lux-espresso">ทดสอบเข้าสู่ระบบตามบทบาท (1-Click)</h6>
                </div>
                <p class="small text-lux-muted mb-3">คลิกเลือกบทบาทที่ต้องการเพื่อทดสอบหน้าจอเฉพาะของแต่ละฝ่ายได้ทันที:</p>

                <div class="d-flex flex-wrap gap-2">
                    @foreach (var u in demoUsers)
                    {
                        <form asp-action="QuickLogin" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="username" value="@u.Username" />
                            <button type="submit" class="btn btn-sm btn-lux-outline d-flex align-items-center gap-2 py-1 px-2" style="font-size: 0.78rem;">
                                <span class="badge rounded-pill @(u.Role == UserRole.Owner ? "bg-dark" :
                                                    u.Role == UserRole.Admin ? "bg-danger" :
                                                    u.Role == UserRole.Customer ? "bg-success" : "bg-secondary")" style="font-size: 0.66rem; font-weight: 500;">
                                    @u.Role
                                </span>
                                <span>@u.Username</span>
                            </button>
                        </form>
                    }
                </div>
                <div class="small text-lux-muted mt-3 text-end" style="font-size: 0.74rem;">
                    * รหัสผ่านสำหรับกรอกเองทุก User คือ: <code>123456</code>
                </div>
            </div>
        </div>
    </div>
</div>
