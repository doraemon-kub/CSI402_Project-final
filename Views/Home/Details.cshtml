@model CSI402_Project_final.Models.Product
@using CSI402_Project_final.Models
@{
    ViewData["Title"] = Model.Name;
    var related = ViewBag.RelatedProducts as List<Product> ?? new();
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">หน้าร้านค้า</a></li>
            <li class="breadcrumb-item">@(Model.PetType == PetCategory.Dog ? "สุนัข" : "แมว")</li>
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <div class="col-md-5">
                <img src="@Model.ImageUrl" class="img-fluid h-100 w-100" style="object-fit: cover; min-height: 380px;" alt="@Model.Name" />
            </div>
            <div class="col-md-7 p-4 p-lg-5 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-danger px-3 py-2 rounded-pill">
                        <i class="bi bi-fire"></i> สินค้ายอดนิยม: มี @Model.CartAddCount คนกำลังใส่ตะกร้าชิ้นนี้ (Req 8)
                    </span>
                    <span class="badge bg-secondary">แบรนด์ @Model.Brand</span>
                </div>

                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                <p class="text-muted mb-4">@Model.Description</p>

                <!-- Spec Info: น้ำหนัก & ช่วงวัย & สูตรเฉพาะ (Req 1, 2, 7, 10) -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-sm-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="small text-muted">สัตว์เลี้ยง</div>
                            <div class="fw-bold">@(Model.PetType == PetCategory.Dog ? "🐶 สุนัข" : "🐱 แมว")</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="small text-muted">ช่วงวัยที่เหมาะสม</div>
                            <div class="fw-bold text-primary">
                                @(Model.AgeStage == AgeStage.PuppyOrKitten ? "🍼 วัยเด็ก" :
                                  Model.AgeStage == AgeStage.Adult ? "🐕 โตเต็มวัย" : "🧓 สูงวัย")
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="small text-muted">น้ำหนักสินค้า</div>
                            <div class="fw-bold">⚖️ @Model.WeightKg kg</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 bg-light rounded-3 text-center">
                            <div class="small text-muted">สูตรการดูแล</div>
                            <div class="fw-bold text-success">@Model.SpecialNeed</div>
                        </div>
                    </div>
                </div>

                <!-- Stock Status Section -->
                <div class="mb-3 d-flex align-items-center gap-2" id="stock-badge-container-@Model.Id">
                    <span class="text-muted small">สถานะสินค้า:</span>
                    @if (Model.IsOutOfStock)
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2">
                            <i class="bi bi-x-circle me-1"></i> สินค้าหมดสต็อกชั่วคราว
                        </span>
                    }
                    else if (Model.IsLowStock)
                    {
                        <span class="badge bg-warning-subtle text-dark border border-warning px-3 py-2">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> สินค้าใกล้หมด! เหลือเพียง <strong id="stock-val-@Model.Id">@Model.StockQuantity</strong> ชิ้น
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> มีสินค้าพร้อมส่ง (คงเหลือ <strong id="stock-val-@Model.Id">@Model.StockQuantity</strong> ชิ้น)
                        </span>
                    }
                </div>

                <!-- Price & Purchase Action -->
                <div class="mt-auto border-top pt-4">
                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        @if (Model.SpecialDiscountPrice.HasValue)
                        {
                            <span class="display-6 fw-bold text-danger">฿@Model.SpecialDiscountPrice.Value.ToString("N0")</span>
                            <span class="fs-5 text-muted text-decoration-line-through">฿@Model.Price.ToString("N0")</span>
                            <span class="badge bg-success-subtle text-success border border-success">ประหยัดทันที</span>
                        }
                        else
                        {
                            <span class="display-6 fw-bold text-dark">฿@Model.Price.ToString("N0")</span>
                        }
                    </div>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="alert alert-warning border-0 rounded-3 p-3 mb-0 shadow-sm">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-lock-fill fs-3 text-warning"></i>
                                    <div>
                                        <div class="fw-bold text-dark">กรุณาเข้าสู่ระบบก่อนหยิบสินค้าลงในตะกร้า</div>
                                        <div class="small text-muted">ผู้เยี่ยมชม (Guest) สามารถชมข้อมูลสินค้าได้ แต่ต้องเข้าสู่ระบบเพื่อซื้อสินค้า</div>
                                    </div>
                                </div>
                                <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary px-3 fw-bold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบเพื่อสั่งซื้อ
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-3 ajax-add-to-cart">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <div style="width: 120px;">
                                <input type="number" name="quantity" class="form-control form-control-lg text-center" value="1" min="1" max="@Model.StockQuantity" id="qty-input-@Model.Id" />
                            </div>
                            <button type="submit" class="btn btn-pet-primary btn-lg flex-grow-1" @(Model.IsOutOfStock ? "disabled" : "") id="add-cart-btn-@Model.Id">
                                <i class="bi bi-cart-plus-fill me-2"></i> <span>เพิ่มลงในตะกร้าสินค้า</span>
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- แนะนำสินค้าตามช่วงวัยและสายพันธุ์เดียวกัน (Req 7, 10) -->
    @if (related.Any())
    {
        <h4 class="fw-bold mb-3"><i class="bi bi-stars text-warning"></i> สินค้าแนะนำสำหรับช่วงวัยนี้</h4>
        <div class="row g-4">
            @foreach (var rel in related)
            {
                <div class="col-md-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <img src="@rel.ImageUrl" class="card-img-top" style="height: 150px; object-fit: cover;" alt="@rel.Name" />
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-truncate">@rel.Name</h6>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-danger">฿@rel.EffectivePrice.ToString("N0")</span>
                                <a asp-action="Details" asp-route-id="@rel.Id" class="btn btn-sm btn-outline-dark">ดูข้อมูล</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
