@model CSI402_Project_final.Models.Product
@using CSI402_Project_final.Models

<div class="col-6 col-md-4 col-lg-3">
    <div class="lux-product-card h-100 d-flex flex-column position-relative">
        <!-- Product Photography Stage -->
        <div class="lux-product-media">
            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" asp-route-role="@ViewContext.HttpContext.Request.Query["role"]" class="d-block w-100 h-100">
                <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
            </a>

            <!-- Floating Age Stage Pill (Req 10) -->
            <div class="position-absolute top-0 end-0 m-2 z-1">
                <span class="lux-glass-pill">
                    @(Model.AgeStage == AgeStage.PuppyOrKitten ? "วัยเด็ก" :
                      Model.AgeStage == AgeStage.Adult ? "โตเต็มวัย" :
                      Model.AgeStage == AgeStage.Senior ? "สูงวัย" : "ทุกวัย")
                </span>
            </div>

            @if (Model.SpecialDiscountPrice.HasValue)
            {
                var savePct = Math.Round((1 - (Model.SpecialDiscountPrice.Value / Model.Price)) * 100);
                if (savePct > 0)
                {
                    <div class="position-absolute bottom-0 start-0 m-2 z-1">
                        <span class="badge rounded-pill px-2 py-1" style="background-color: var(--lux-danger); font-size: 0.68rem; font-weight: 500;">
                            -@savePct%
                        </span>
                    </div>
                }
            }
        </div>

        <!-- Product Info Body -->
        <div class="p-3 d-flex flex-column flex-grow-1">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                <span class="lux-product-brand text-truncate">@Model.Brand</span>
                <span class="text-lux-muted flex-shrink-0" style="font-size: 0.72rem;">@Model.WeightKg kg</span>
            </div>

            <h6 class="lux-product-title mb-2" title="@Model.Name">
                <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" asp-route-role="@ViewContext.HttpContext.Request.Query["role"]">
                    @Model.Name
                </a>
            </h6>

            <!-- Tags & Real-time Stock Status -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-1 mb-3">
                <div class="d-flex flex-wrap gap-1">
                    <span class="lux-tag">
                        @(Model.PetType == PetCategory.Dog ? "สุนัข" : Model.PetType == PetCategory.Cat ? "แมว" : "อื่นๆ")
                    </span>
                    <span class="lux-tag lux-tag-accent">@Model.SpecialNeed</span>
                </div>

                <div id="stock-badge-container-@Model.Id">
                    @if (Model.IsOutOfStock)
                    {
                        <span class="lux-stock-pill lux-stock-out">
                            <span class="lux-stock-dot"></span> สินค้าหมด
                        </span>
                    }
                    else if (Model.IsLowStock)
                    {
                        <span class="lux-stock-pill lux-stock-low">
                            <span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-@Model.Id">@Model.StockQuantity</strong> ชิ้น
                        </span>
                    }
                    else
                    {
                        <span class="lux-stock-pill lux-stock-ok">
                            <span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-@Model.Id">@Model.StockQuantity</strong> ชิ้น
                        </span>
                    }
                </div>
            </div>

            <!-- Price & Action Footer -->
            <div class="mt-auto pt-2" style="border-top: 1px solid var(--lux-border);">
                <div class="d-flex align-items-baseline gap-2 mb-2">
                    @if (Model.SpecialDiscountPrice.HasValue)
                    {
                        <span class="lux-price-now lux-price-sale">฿@Model.SpecialDiscountPrice.Value.ToString("N0")</span>
                        <span class="lux-price-old">฿@Model.Price.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="lux-price-now">฿@Model.Price.ToString("N0")</span>
                    }
                </div>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                       class="btn btn-lux-guest w-100 btn-sm d-flex align-items-center justify-content-center gap-1 py-2"
                       style="font-size: 0.8rem;" title="เข้าสู่ระบบเพื่อหยิบสินค้าลงในตะกร้า">
                        <i class="bi bi-lock"></i> <span>เข้าสู่ระบบก่อนซื้อ</span>
                    </a>
                }
                else if (Model.IsOutOfStock)
                {
                    <button type="button" class="btn btn-secondary w-100 btn-sm rounded-3 py-2" disabled style="font-size: 0.8rem;" id="add-cart-btn-@Model.Id">
                        <i class="bi bi-x-circle me-1"></i> หมดสต็อก
                    </button>
                }
                else
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="ajax-add-to-cart m-0" id="add-to-cart-form-@Model.Id" data-product-name="@Model.Name">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-pet-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1 py-2" style="font-size: 0.82rem;" id="add-cart-btn-@Model.Id">
                            <i class="bi bi-bag-plus"></i> <span>เพิ่มลงตะกร้า</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
