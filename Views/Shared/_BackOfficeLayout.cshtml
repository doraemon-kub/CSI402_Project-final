@using CSI402_Project_final.Models
@using System.Security.Claims
@inject CSI402_Project_final.Models.PetShopRepository Repo
@{
    var roleParam = ViewContext.HttpContext.Request.Query["role"].FirstOrDefault() 
                    ?? ViewContext.HttpContext.Request.Query["asRole"].FirstOrDefault();

    var currentRole = User.FindFirstValue(ClaimTypes.Role) ?? "Guest";
    var username = User.Identity?.Name ?? "พนักงาน";
    var rawFullName = User.FindFirst("FullName")?.Value ?? username;

    if (!string.IsNullOrEmpty(roleParam))
    {
        if (string.Equals(roleParam, "guest", StringComparison.OrdinalIgnoreCase))
        {
            currentRole = "Guest";
            username = "ผู้เยี่ยมชม";
            rawFullName = "ผู้เยี่ยมชม";
        }
        else
        {
            var demo = DemoUserHelper.GetDemoUserInfo(roleParam);
            currentRole = demo.RoleName;
            username = demo.Username;
            rawFullName = demo.FullName;
        }
    }

    var fullName = System.Text.RegularExpressions.Regex.Replace(rawFullName ?? "", @"\s*\([^)]*\)", "").Trim();
    if (string.IsNullOrEmpty(fullName)) fullName = username;
    string activeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    bool HasRole(string role) => string.Equals(currentRole, role, StringComparison.OrdinalIgnoreCase);
    bool IsActive(string ctrl) => string.Equals(activeCtrl, ctrl, StringComparison.OrdinalIgnoreCase);
    bool isOwner = HasRole("Owner");
}
<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetStore Back-Office</title>

    <!-- Tab-Isolated Session Enforcer (รองรับการเปิดหลายแท็บ/แยกบทบาทอิสระในบราวเซอร์เดียวกันเหมือน React/sessionStorage) -->
    <script>
        (function () {
            try {
                var path = window.location.pathname.toLowerCase();
                var url = new URL(window.location.href);
                var urlRole = url.searchParams.get('role') || url.searchParams.get('asRole');
                var tabRole = sessionStorage.getItem('petshop_tab_role');

                if (urlRole) {
                    sessionStorage.setItem('petshop_tab_role', urlRole);
                } else if (tabRole && tabRole !== 'Guest') {
                    url.searchParams.set('role', tabRole);
                    window.location.replace(url.toString());
                } else {
                    var defaultRole = 'Owner';
                    if (path.startsWith('/admin')) defaultRole = 'Admin';
                    else if (path.startsWith('/inventory')) defaultRole = 'InventoryStaff';
                    else if (path.startsWith('/order')) defaultRole = 'OrderStaff';
                    else if (path.startsWith('/shipping')) defaultRole = 'ShippingStaff';
                    else if (path.startsWith('/marketing')) defaultRole = 'MarketingStaff';
                    else if (path.startsWith('/accounting')) defaultRole = 'AccountingStaff';
                    else if (path.startsWith('/support')) defaultRole = 'ITSupport';
                    else if (path.startsWith('/owner')) defaultRole = 'Owner';

                    sessionStorage.setItem('petshop_tab_role', defaultRole);
                    url.searchParams.set('role', defaultRole);
                    window.location.replace(url.toString());
                }
            } catch (e) { }
        })();
    </script>
    <!-- Google Fonts: Playfair Display + Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Minimalist Luxury Design System -->
    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    
    <style>
        body {
            overflow-x: hidden;
        }

        .wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Desktop Sidebar */
        .sidebar {
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.25s ease-in-out;
        }

        /* Collapsed Sidebar on Desktop */
        body.sidebar-collapsed .sidebar-desktop {
            margin-left: -268px;
        }

        .sidebar-menu {
            padding: 14px 0;
            flex: 1;
        }

        .content-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .main-body {
            padding: 18px;
            flex: 1;
        }

        @@media (min-width: 768px) {
            .main-body {
                padding: 28px;
            }
        }

        /* Mobile/Tablet Offcanvas Menu */
        @@media (max-width: 991.98px) {
            .sidebar-desktop {
                display: none !important;
            }
        }
    </style>
</head>

<body class="lux-backoffice">
    <div class="wrapper">
        <!-- 1. Desktop Sidebar (แสดงเฉพาะจอใหญ่) -->
        <aside class="sidebar sidebar-desktop">
            <div class="sidebar-brand">
                <span class="pet-brand-mark" style="width: 32px; height: 32px; font-size: 0.9rem; background: rgba(223,195,168,0.14); border: 1px solid rgba(223,195,168,0.3);">
                    <i class="bi bi-stars"></i>
                </span>
                <span>PetStore <span class="text-lux-gold">Hub</span></span>
            </div>
            <div class="sidebar-menu">
                <div class="px-4 py-2 small text-uppercase fw-semibold" style="font-size: 0.68rem; letter-spacing: 0.08em; color: #8F8277;">
                    @(isOwner ? "Owner Full Access" : $"Role · {currentRole}")
                </div>
                
                @if (isOwner || HasRole("InventoryStaff"))
                {
                    <a asp-controller="Inventory" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Inventory") ? "active" : "")">
                        <i class="bi bi-boxes"></i> คลังสินค้า (Inventory)
                    </a>
                }
                @if (isOwner || HasRole("OrderStaff"))
                {
                    <a asp-controller="Order" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Order") ? "active" : "")">
                        <i class="bi bi-card-checklist"></i> คำสั่งซื้อ (Order)
                    </a>
                }
                @if (isOwner || HasRole("ShippingStaff"))
                {
                    <a asp-controller="Shipping" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Shipping") ? "active" : "")">
                        <i class="bi bi-truck"></i> จัดการจัดส่ง (Shipping)
                    </a>
                }
                @if (isOwner || HasRole("MarketingStaff"))
                {
                    <a asp-controller="Marketing" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Marketing") ? "active" : "")">
                        <i class="bi bi-tags"></i> แคมเปญโปรโมชั่น (MKT)
                    </a>
                }
                @if (isOwner || HasRole("AccountingStaff"))
                {
                    <a asp-controller="Accounting" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Accounting") ? "active" : "")">
                        <i class="bi bi-cash-coin"></i> การเงินและบัญชี (ACC)
                    </a>
                }
                @if (isOwner || HasRole("ITSupport"))
                {
                    <a asp-controller="Support" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Support") ? "active" : "")">
                        <i class="bi bi-headset"></i> IT Support Helpdesk
                    </a>
                }
                @if (isOwner || HasRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                       class="sidebar-link @(IsActive("Admin") ? "active" : "")">
                        <i class="bi bi-person-gear"></i> สิทธิ์และผู้ใช้ (Admin)
                    </a>
                }
                @if (isOwner)
                {
                    <a asp-controller="Owner" asp-action="Index" asp-route-role="Owner"
                       class="sidebar-link @(IsActive("Owner") ? "active" : "")">
                        <i class="bi bi-graph-up-arrow"></i> ภาพรวมธุรกิจ (Owner)
                    </a>
                }
            </div>
            
            <div class="p-3 border-top border-secondary">
                <a href="/flowchart_viewer.html" target="_blank" class="btn btn-outline-warning w-100 btn-sm mb-2">
                    <i class="bi bi-diagram-3 me-1"></i> ผังงานระบบ (Flowcharts)
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 btn-sm mb-2">
                    <i class="bi bi-shop me-1"></i> ไปหน้าร้านค้า
                </a>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0" onsubmit="sessionStorage.setItem('petshop_tab_role', 'Guest');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                    </button>
                </form>
            </div>
        </aside>

        <!-- 2. Mobile/Tablet Offcanvas Drawer (สำหรับ iPad, Tablet, Phone) -->
        <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="sidebarOffcanvas"
             style="width: 280px;">
            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title fw-bold text-warning"><i class="bi bi-gear-wide-connected"></i> Back-Office
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>
            <div class="offcanvas-body p-0 d-flex flex-column">
                <div class="p-3 bg-black bg-opacity-25 border-bottom border-secondary">
                    <div class="small text-muted">ผู้ใช้ปัจจุบัน:</div>
                    <div class="fw-bold text-white text-truncate">@fullName</div>
                    <span class="badge bg-primary mt-1">@currentRole</span>
                </div>
                <div class="py-2 flex-grow-1">
                    @if (isOwner || HasRole("InventoryStaff"))
                    {
                        <a asp-controller="Inventory" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                           class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-boxes me-2 text-warning"></i> คลังสินค้า (Inventory)
                        </a>
                    }
                    @if (isOwner || HasRole("OrderStaff"))
                    {
                        <a asp-controller="Order" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))" class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-card-checklist me-2 text-warning"></i> คำสั่งซื้อ (Order)
                        </a>
                    }
                    @if (isOwner || HasRole("ShippingStaff"))
                    {
                        <a asp-controller="Shipping" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                           class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-truck me-2 text-warning"></i> จัดการจัดส่ง (Shipping)
                        </a>
                    }
                    @if (isOwner || HasRole("MarketingStaff"))
                    {
                        <a asp-controller="Marketing" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                           class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-tags me-2 text-warning"></i> แคมเปญโปรโมชั่น (MKT)
                        </a>
                    }
                    @if (isOwner || HasRole("AccountingStaff"))
                    {
                        <a asp-controller="Accounting" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))"
                           class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-cash-coin me-2 text-warning"></i> การเงินและบัญชี (ACC)
                        </a>
                    }
                    @if (isOwner || HasRole("ITSupport"))
                    {
                        <a asp-controller="Support" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))" class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-headset me-2 text-warning"></i> IT Support Helpdesk
                        </a>
                    }
                    @if (isOwner || HasRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" asp-route-role="@(!string.IsNullOrEmpty(roleParam) ? roleParam : (isOwner ? "Owner" : null))" class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-person-gear me-2 text-warning"></i> สิทธิ์และผู้ใช้ (Admin)
                        </a>
                    }
                    @if (isOwner)
                    {
                        <a asp-controller="Owner" asp-action="Index" asp-route-role="Owner" class="sidebar-link text-white-50 px-3 py-2 d-block">
                            <i class="bi bi-graph-up-arrow me-2 text-warning"></i> ภาพรวมธุรกิจ (Owner)
                        </a>
                    }
                </div>
                <div class="p-3 border-top border-secondary">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 btn-sm mb-2">
                        <i class="bi bi-shop me-1"></i> หน้าร้านค้า
                    </a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0" onsubmit="sessionStorage.setItem('petshop_tab_role', 'Guest');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100 btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 3. Main Content Area -->
        <div class="content-area">
            <!-- Topbar with Offcanvas Toggle Button on Mobile/Tablet -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-lux-outline py-1 px-2" type="button" id="sidebarToggleBtn"
                            title="เปิด/ปิดเมนูข้าง (Toggle Sidebar)">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h6 class="m-0 fw-bold text-lux-espresso text-truncate" style="max-width: 340px;">@ViewData["Title"]</h6>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <!-- Multi-Role Switcher: สลับบทบาทผู้ใช้งานทันที -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-lux-outline py-1 px-2 rounded-pill d-flex align-items-center gap-1" data-bs-toggle="dropdown" style="font-size: 0.72rem;" title="สลับบทบาทผู้ใช้งาน (Multi-Role)">
                            <i class="bi bi-layers-half text-warning"></i>
                            <span class="d-none d-md-inline">Multi-Role</span>
                            <i class="bi bi-chevron-down" style="font-size: 0.6rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm small p-2" style="min-width: 240px; font-size: 0.8rem;">
                            <li class="dropdown-header text-uppercase text-lux-muted" style="font-size: 0.65rem;">สลับบทบาทเฉพาะแท็บนี้ (Multi-Role)</li>
                            <li><a class="dropdown-item py-1 rounded" href="/?role=Guest"><i class="bi bi-globe me-2 text-muted"></i> 🌐 ผู้เยี่ยมชม (Guest)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/?role=Customer"><i class="bi bi-person me-2 text-success"></i> 👤 ลูกค้า (Customer)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Inventory?role=InventoryStaff"><i class="bi bi-boxes me-2 text-primary"></i> 📦 คลังสินค้า (Inventory)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Order?role=OrderStaff"><i class="bi bi-card-checklist me-2 text-info"></i> 📋 คำสั่งซื้อ (Order)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Shipping?role=ShippingStaff"><i class="bi bi-truck me-2 text-warning"></i> 🚚 จัดส่งสินค้า (Shipping)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Marketing?role=MarketingStaff"><i class="bi bi-tags me-2 text-danger"></i> 🏷️ โปรโมชั่น (Marketing)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Accounting?role=AccountingStaff"><i class="bi bi-cash-coin me-2 text-success"></i> 💰 การเงิน/บัญชี (ACC)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Support?role=ITSupport"><i class="bi bi-headset me-2 text-primary"></i> 🎧 IT Support (Helpdesk)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Admin?role=Admin"><i class="bi bi-person-gear me-2 text-secondary"></i> ⚙️ ผู้ดูแลระบบ (Admin)</a></li>
                            <li><a class="dropdown-item py-1 rounded" href="/Owner?role=Owner"><i class="bi bi-graph-up-arrow me-2 text-lux-gold"></i> 👑 เจ้าของร้าน (Owner)</a></li>
                        </ul>
                    </div>

                    <div class="text-end d-none d-sm-block">
                        <div class="small fw-semibold text-lux-espresso text-truncate" style="max-width: 180px;">@fullName</div>
                        <span class="lux-tag lux-tag-accent" style="font-size: 0.65rem;">@currentRole</span>
                    </div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0" onsubmit="sessionStorage.setItem('petshop_tab_role', 'Guest');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-lux-outline px-3" title="ออกจากระบบ">
                            <i class="bi bi-box-arrow-right"></i> <span class="d-none d-md-inline ms-1">ออกจากระบบ</span>
                        </button>
                    </form>
                </div>
            </header>

            <!-- Notifications -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="px-3 pt-2 pb-0">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm m-0 rounded-3 py-2 px-3 small d-flex align-items-center justify-content-between"
                         role="alert">
                        <div class="d-flex align-items-center me-2">
                            <i class="bi bi-check-circle-fill me-2 fs-6"></i>
                            <span>@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="btn-close position-static p-1 m-0" data-bs-dismiss="alert" aria-label="Close" style="width: 0.75rem; height: 0.75rem; flex-shrink: 0;"></button>
                    </div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="px-3 pt-2 pb-0">
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm m-0 rounded-3 py-2 px-3 small d-flex align-items-center justify-content-between"
                         role="alert">
                        <div class="d-flex align-items-center me-2">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-6"></i>
                            <span>@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="btn-close position-static p-1 m-0" data-bs-dismiss="alert" aria-label="Close" style="width: 0.75rem; height: 0.75rem; flex-shrink: 0;"></button>
                    </div>
                </div>
            }

            <!-- Body View -->
            <main class="main-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Real-time Live Toast Container สำหรับพนักงาน -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="staffRealtimeToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert"
             aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="staffRealtimeToastBody">
                    <i class="bi bi-broadcast text-warning fs-5"></i>
                    <span>ระบบแจ้งเตือน Real-time พร้อมใช้งาน</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const staffHubConnection = new signalR.HubConnectionBuilder()
            .withUrl("/petShopHub")
            .withAutomaticReconnect()
            .build();

        // 1. รับแจ้งเตือนออเดอร์ใหม่แบบ Real-Time (Order Staff / Owner)
        staffHubConnection.on("ReceiveNewOrderAlert", function (orderId, customerName, grandTotal) {
            showStaffToast(`🔔 ออเดอร์ใหม่! #${orderId} จาก ${customerName} (ยอด ฿${grandTotal})`);
            // ถ้าอยู่ในหน้าออเดอร์ ให้รีโหลดหรือแสดงไฮไลต์
            if (window.location.pathname.includes("/Order")) {
                setTimeout(() => window.location.reload(), 2000);
            }
        });

        // 2. รับแจ้งเตือนสินค้าสต็อกต่ำกว่าเกณฑ์แบบ Real-Time (Req 18: Inventory Staff)
        staffHubConnection.on("ReceiveLowStockAlert", function (productName, currentStock) {
            showStaffToast(`⚠️ เตือนสต็อกต่ำ! สินค้า '${productName}' เหลือเพียง ${currentStock} ชิ้น`);
        });

        staffHubConnection.start().catch(err => console.log("Staff SignalR Error: ", err));

        function showStaffToast(message) {
            const toastEl = document.getElementById('staffRealtimeToast');
            const toastBody = document.getElementById('staffRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `<i class="bi bi-bell-fill text-warning fs-5"></i> <span>${message}</span>`;
                const bsToast = new bootstrap.Toast(toastEl, { delay: 6000 });
                bsToast.show();
            }
        }

        // Universal Sidebar Toggle (Desktop & Mobile)
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById("sidebarToggleBtn");
            const offcanvasEl = document.getElementById("sidebarOffcanvas");
            let bsOffcanvas = null;

            if (offcanvasEl && typeof bootstrap !== "undefined" && bootstrap.Offcanvas) {
                bsOffcanvas = new bootstrap.Offcanvas(offcanvasEl);
            }

            // Restore collapsed state on desktop
            if (window.innerWidth >= 992) {
                if (localStorage.getItem("backoffice_sidebar_collapsed") === "true") {
                    document.body.classList.add("sidebar-collapsed");
                }
            }

            if (toggleBtn) {
                toggleBtn.addEventListener("click", function () {
                    if (window.innerWidth < 992) {
                        // Mobile / Tablet: Open Offcanvas drawer
                        if (bsOffcanvas) {
                            bsOffcanvas.toggle();
                        } else {
                            const instance = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                            instance.toggle();
                        }
                    } else {
                        // Desktop: Toggle collapsed class on body
                        document.body.classList.toggle("sidebar-collapsed");
                        const isCollapsed = document.body.classList.contains("sidebar-collapsed");
                        localStorage.setItem("backoffice_sidebar_collapsed", isCollapsed ? "true" : "false");
                    }
                });
            }
        });
    </script>
    <!-- Socket.io / SignalR Real-Time WebSocket Engine -->
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/petstore-socket.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
