                        }
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="footer-title">ติดต่อเรา</h6>
                    <ul class="list-unstyled small text-white-50 mb-3">
                        <li class="mb-1"><i class="bi bi-geo-alt text-warning me-2"></i> จตุจักร กรุงเทพฯ 10900</li>
                        <li class="mb-1"><i class="bi bi-envelope text-warning me-2"></i> contact@petstorepro.com</li>
                        <li><i class="bi bi-clock text-warning me-2"></i> 08:00 - 21:00 น. ทุกวัน</li>
                    </ul>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">PromptPay</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Visa/Mastercard</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Flash</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Kerry</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="bottom-bar">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 text-white-50 small text-center text-sm-start">
                <div>© 2026 PetStore Pro. All rights reserved. (Activity 2 CSI402)</div>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="/flowchart_viewer.html" target="_blank" class="text-warning text-decoration-none fw-medium"><i class="bi bi-diagram-3 me-1"></i> ผังงานระบบ & สถาปัตยกรรม (Flowcharts)</a>
                    <span>•</span>
                    <a href="/wireframe_viewer.html" target="_blank" class="text-info text-decoration-none fw-medium"><i class="bi bi-layout-text-window-reverse me-1"></i> แบบร่างหน้าจอ (Wireframe Studio)</a>
                    <span>•</span>
                    <a href="#" class="text-white-50 text-decoration-none">นโยบายความเป็นส่วนตัว</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Real-time Live Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="liveRealtimeToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="liveRealtimeToastBody">
                    <i class="bi bi-broadcast text-warning fs-5"></i>
                    <span>กำลังเชื่อมต่อสัญญาณ Real-time...</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Microsoft SignalR JavaScript Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // เริ่มต้นการเชื่อมต่อ SignalR WebSocket
        const petShopConnection = new signalR.HubConnectionBuilder()
            .withUrl("/petShopHub")
            .withAutomaticReconnect()
            .build();

        // 1. รับการอัปเดตจำนวนคนใส่ตะกร้าแบบ Real-time (Req 8)
        petShopConnection.on("ReceiveCartCountUpdate", function (productId, newCount) {
            const countValEl = document.getElementById(`cart-count-val-${productId}`);
            const badgeEl = document.getElementById(`cart-count-badge-${productId}`);
            if (countValEl) {
                countValEl.innerText = newCount;
                if (badgeEl) {
                    badgeEl.classList.add("lux-glass-pill-pulse");
                    setTimeout(() => {
                        badgeEl.classList.remove("lux-glass-pill-pulse");
                    }, 1200);
                }
            }
        });

        // รับการอัปเดตจำนวนสต็อกคงเหลือแบบ Real-time (ลดเมื่อใส่ตะกร้า และคืนเมื่อเอาออก)
        petShopConnection.on("ReceiveStockUpdate", function (productId, remainingStock) {
            updateProductStockUI(productId, remainingStock);
        });

        function updateProductStockUI(productId, remainingStock) {
            const stockValEl = document.getElementById(`stock-val-${productId}`);
            if (stockValEl) {
                stockValEl.textContent = remainingStock;
            }
            const container = document.getElementById(`stock-badge-container-${productId}`);
            const addBtn = document.getElementById(`add-cart-btn-${productId}`);
            const qtyInput = document.getElementById(`qty-input-${productId}`);

            if (qtyInput) {
                qtyInput.max = remainingStock;
                if (parseInt(qtyInput.value) > remainingStock) {
                    qtyInput.value = Math.max(1, remainingStock);
                }
            }

            if (remainingStock <= 0) {
                if (container) {
                    container.innerHTML = '<span class="lux-stock-pill lux-stock-out"><span class="lux-stock-dot"></span> สินค้าหมด</span>';
                }
                if (addBtn) {
                    addBtn.disabled = true;
                    addBtn.className = 'btn btn-secondary w-100 btn-sm rounded-3';
                    addBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> หมดสต็อก';
                }
            } else if (remainingStock <= 5) {
                if (container) {
                    container.innerHTML = `<span class="lux-stock-pill lux-stock-low"><span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-${productId}">${remainingStock}</strong> ชิ้น</span>`;
                }
                if (addBtn && addBtn.disabled) {
                    addBtn.disabled = false;
                    addBtn.className = 'btn btn-pet-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1';
                    addBtn.innerHTML = '<i class="bi bi-bag-plus"></i> <span>เพิ่มลงตะกร้า</span>';
                }
            } else {
                if (container) {
                    container.innerHTML = `<span class="lux-stock-pill lux-stock-ok"><span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-${productId}">${remainingStock}</strong> ชิ้น</span>`;
                }
                if (addBtn && addBtn.disabled) {
                    addBtn.disabled = false;
                    addBtn.className = 'btn btn-pet-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1';
                    addBtn.innerHTML = '<i class="bi bi-bag-plus"></i> <span>เพิ่มลงตะกร้า</span>';
                }
            }
        }

        // 2. รับแจ้งเตือนเมื่อพัสดุจัดส่งแล้ว
        petShopConnection.on("ReceiveOrderShippedAlert", function (orderId, trackingNumber, courier) {
            showRealtimeToast(`🚚 ออเดอร์ #${orderId} ถูกจัดส่งแล้ว! (${courier}: ${trackingNumber})`);
        });

        // 3. รับแจ้งเตือนเมื่อมีออเดอร์ใหม่
        petShopConnection.on("ReceiveNewOrderAlert", function (orderId, customerName, grandTotal) {
            showRealtimeToast(`🎉 มีคำสั่งซื้อใหม่ #${orderId} จาก ${customerName} (฿${grandTotal})`);
        });

        // 4. เตะผู้ใช้ออกจากระบบแบบ Real-Time ทันทีเมื่อบัญชีถูกผู้ดูแลระบบสั่งระงับระหว่างกำลังใช้งาน
        petShopConnection.on("ReceiveAccountSuspended", function (suspendedUsername, suspendedRole, reason, untilText) {
            const currentTabUser = "@currentUsername".toLowerCase();
            const currentTabRole = (sessionStorage.getItem('petshop_tab_role') || "@currentRoleName").toLowerCase();
            const targetUser = (suspendedUsername || "").toLowerCase();
            const targetRole = (suspendedRole || "").toLowerCase();

            if ((currentTabUser && currentTabUser === targetUser) ||
                (currentTabRole !== "guest" && currentTabRole === targetRole)) {
                sessionStorage.setItem('petshop_tab_role', 'Guest');
                window.location.replace(`/Auth/Login?suspended=true&u=${encodeURIComponent(suspendedUsername)}&reason=${encodeURIComponent(reason)}&until=${encodeURIComponent(untilText)}`);
            }
        });

        petShopConnection.start().catch(err => console.log("SignalR Connection Error: ", err));

        function showRealtimeToast(message) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `<i class="bi bi-bell-fill text-warning fs-5"></i> <span>${message}</span>`;
                const bsToast = new bootstrap.Toast(toastEl, { delay: 5000 });
                bsToast.show();
            }
        }
        // 4. ระบบเพิ่มสินค้าลงตะกร้าแบบ Optimistic Instant Feedback (กดปุ๊บ เพิ่มทันทีใน 0 ms ไม่ต้องรอหมุนโหลด)
        document.addEventListener('submit', async function (e) {
            const form = e.target.closest('form.ajax-add-to-cart, form[action*="/Cart/Add"]');
            if (!form) return;

            e.preventDefault();

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalHtml = submitBtn ? submitBtn.innerHTML : '';
            const formData = new FormData(form);
            const productId = formData.get('productId');
            const qtyToAdd = parseInt(formData.get('quantity') || '1', 10) || 1;

            // ดึงชื่อสินค้า
            let productName = form.getAttribute('data-product-name');
            if (!productName) {
                const titleEl = form.closest('.lux-product-card')?.querySelector('.lux-product-title a') 
                             || document.querySelector('h2');
                productName = titleEl ? titleEl.textContent.trim() : 'สินค้า';
            }

            // คำนวณ Optimistic Cart Count ทันที
            let prevCartCount = 0;
            const anyBadge = document.querySelector('.badge-cart');
            if (anyBadge) {
                prevCartCount = parseInt(anyBadge.textContent.trim(), 10) || 0;
            }
            const optimisticCartCount = prevCartCount + qtyToAdd;

            // [Optimistic 1]: อัปเดตตัวเลขบนตะกร้าทันทีใน 0 ms พร้อมเอฟเฟกต์เด้ง (Bounce)
            document.querySelectorAll('.badge-cart').forEach(badge => {
                badge.textContent = optimisticCartCount;
                badge.classList.remove('badge-bump');
                void badge.offsetWidth; // trigger reflow
                badge.classList.add('badge-bump');
            });

            // [Optimistic 2]: เปลี่ยนปุ่มเป็นสีเขียว "เพิ่มแล้ว!" ทันที ไม่ค้าง ไม่ขึ้น spinner ให้เสียเวลา
            if (submitBtn) {
                submitBtn.classList.remove('btn-pet-primary');
                submitBtn.classList.add('btn-success');
                submitBtn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> เพิ่มแล้ว!';

                setTimeout(() => {
                    submitBtn.classList.remove('btn-success');
                    submitBtn.classList.add('btn-pet-primary');
                    submitBtn.innerHTML = originalHtml;
                }, 900);
            }

            // [Optimistic 3]: อัปเดตจำนวนสต็อกบนหน้าจอทันที
            const stockValEl = document.getElementById(`stock-val-${productId}`);
            let prevStock = null;
            if (stockValEl) {
                prevStock = parseInt(stockValEl.textContent.trim(), 10);
                if (!isNaN(prevStock)) {
                    const newStock = Math.max(0, prevStock - qtyToAdd);
                    stockValEl.textContent = newStock;
                    if (newStock === 0) {
                        updateProductStockUI(productId, 0);
                    }
                }
            }

            // [Optimistic 4]: แสดง Toast แจ้งเตือนมุมขวาล่างทันที
            showCartToast(productName, optimisticCartCount);

            // [Background Sync]: ส่งบันทึกลง Database ในพื้นหลัง
            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    const data = await response.json();

                    // กรณีที่ผู้ใช้ยังไม่ได้ล็อกอิน (Guest) นำทางไปหน้าเข้าสู่ระบบทันที
                    if (data.requireLogin) {
                        // Rollback
                        document.querySelectorAll('.badge-cart').forEach(badge => badge.textContent = prevCartCount);
                        if (stockValEl && prevStock !== null) stockValEl.textContent = prevStock;
                        if (submitBtn) {
                            submitBtn.classList.remove('btn-success');
                            submitBtn.classList.add('btn-pet-primary');
                            submitBtn.innerHTML = originalHtml;
                        }
                        showWarningToast(data.message || 'กรุณาเข้าสู่ระบบก่อนหยิบสินค้าลงในตะกร้า');
                        setTimeout(() => {
                            window.location.href = data.redirectUrl || '/Auth/Login';
                        }, 1000);
                        return;
                    }

                    if (!data.success) {
                        // Rollback
                        document.querySelectorAll('.badge-cart').forEach(badge => badge.textContent = prevCartCount);
                        if (stockValEl && prevStock !== null) stockValEl.textContent = prevStock;
                        if (submitBtn) {
                            submitBtn.classList.remove('btn-success');
                            submitBtn.classList.add('btn-pet-primary');
                            submitBtn.innerHTML = originalHtml;
                        }
                        showWarningToast(data.message || 'ไม่สามารถเพิ่มสินค้าลงในตะกร้าได้');
                        return;
                    }

                    // ซิงค์ตัวเลขจริงจาก Server ให้ตรงกัน
                    document.querySelectorAll('.badge-cart').forEach(badge => {
                        badge.textContent = data.cartCount;
                    });

                    // อัปเดตจำนวนคนใส่ตะกร้า (Req 8 Real-time count)
                    const countValEl = document.getElementById(`cart-count-val-${data.productId}`);
                    if (countValEl) {
                        countValEl.textContent = data.productCartCount;
                    }

                    // อัปเดตสต็อกจริงจาก Server
                    if (typeof data.remainingStock !== 'undefined') {
                        updateProductStockUI(data.productId, data.remainingStock);
                    }
                } else {
                    form.submit();
                }
            } catch (err) {
                console.error('AJAX add to cart failed, fallback to submit:', err);
                form.submit();
            }
        });

        function showCartToast(productName, cartCount) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-success rounded-circle text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="bi bi-cart-check-fill fs-6"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-white small">เพิ่มลงในตะกร้าแล้ว!</div>
                            <div class="text-white-50 text-truncate" style="font-size: 0.75rem;">${productName} (ในตะกร้ามี ${cartCount} ชิ้น)</div>
                        </div>
                    </div>`;
                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 });
                bsToast.show();
            }
        }

        function showWarningToast(message) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-warning rounded-circle text-dark d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="bi bi-shield-lock-fill fs-6"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-white small">แจ้งเตือนจากระบบ</div>
                            <div class="text-white small text-truncate" style="font-size: 0.8rem;">${message}</div>
                        </div>
                    </div>`;
                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 4000 });
                bsToast.show();
            }
        }
    </script>
    <!-- Socket.io / SignalR Real-Time WebSocket Engine -->
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/petstore-socket.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
