                    <span class="badge-cart">@cartCount</span>
                </a>
                <button class="navbar-toggler p-2 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-role="@roleParam">
                            สินค้าทั้งหมด
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Dog" asp-route-role="@roleParam">
                            สุนัข
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Cat" asp-route-role="@roleParam">
                            แมว
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Other" asp-route-role="@roleParam">
                            สัตว์เลี้ยงอื่นๆ
