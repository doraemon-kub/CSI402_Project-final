@using CSI402_Project_final.Models
@using System.Security.Claims
@inject CSI402_Project_final.Models.PetShopRepository Repo
@{
    var roleParam = ViewContext.HttpContext.Request.Query["role"].FirstOrDefault() 
                    ?? ViewContext.HttpContext.Request.Query["asRole"].FirstOrDefault();

    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var currentUsername = User.Identity?.Name ?? "";
    var currentRoleName = User.FindFirstValue(ClaimTypes.Role) ?? "Guest";
    var rawFullName = User.FindFirst("FullName")?.Value ?? currentUsername;

    var currentPathLower = ViewContext.HttpContext.Request.Path.Value?.Trim().ToLowerInvariant() ?? "";
    if (currentPathLower.StartsWith("/auth/login") || currentPathLower.StartsWith("/auth/register"))
    {
        roleParam = "guest";
    }

    if (!string.IsNullOrEmpty(roleParam))
    {
        if (string.Equals(roleParam, "guest", StringComparison.OrdinalIgnoreCase))
        {
            isAuthenticated = false;
            currentRoleName = "Guest";
            currentUsername = "";
            rawFullName = "ผู้เยี่ยมชม";
        }
        else
        {
            var resolved = Repo.ResolveTabUserInfo(roleParam);
            if (!isAuthenticated || !string.Equals(currentUsername, resolved.Username, StringComparison.OrdinalIgnoreCase))
            {
                isAuthenticated = true;
                currentRoleName = resolved.RoleName;
                currentUsername = resolved.Username;
                rawFullName = resolved.FullName;
            }
        }
    }

    var fullName = System.Text.RegularExpressions.Regex.Replace(rawFullName ?? "", @"\s*\([^)]*\)", "").Trim();
    if (string.IsNullOrEmpty(fullName)) fullName = currentUsername;
    var cartCount = Repo.CurrentCart.TotalItemCount;
    var isStaffOrAdmin = isAuthenticated && currentRoleName != "Customer" && currentRoleName != "Guest";

    // ดึงและลบ TempData Cookie ทันทีตั้งแต่ก่อนเริ่มเขียน HTML Stream (ป้องกัน Response Flush > 64KB ทำให้ลบ Cookie ไม่ทันแล้วข้อความค้างไปโผล่แท็บอื่น)
    var flashSuccess = TempData["SuccessMessage"] as string;
    var flashError = TempData["ErrorMessage"] as string;
    var flashTargetRole = TempData["SuccessTargetRole"] as string;
    var flashTargetUser = TempData["SuccessTargetUser"] as string;

    if (TempData.Keys.Any())
    {
        TempData.Clear();
        ViewContext.HttpContext.Response.Cookies.Delete(".AspNetCore.Mvc.CookieTempDataProvider");
    }

    // ตรวจสอบว่าข้อความแจ้งเตือนนี้เป็นของ Role/User ในแท็บนี้จริงหรือไม่ (ป้องกันข้อความข้ามแท็บ)
    if (!string.IsNullOrEmpty(flashSuccess))
    {
        if (!string.IsNullOrEmpty(flashTargetRole) &&
            !string.Equals(flashTargetRole, currentRoleName, StringComparison.OrdinalIgnoreCase))
        {
            flashSuccess = null;
        }
        else if (!string.IsNullOrEmpty(flashTargetUser) &&
                 !string.Equals(flashTargetUser, currentUsername, StringComparison.OrdinalIgnoreCase))
        {
            flashSuccess = null;
        }
    }
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetStore Pro</title>

    <!-- Tab-Isolated Session Enforcer (รองรับการเปิดหลายแท็บ/แยกบทบาทอิสระในบราวเซอร์เดียวกันเหมือน React/sessionStorage) -->
    <script>
        (function () {
            try {
                var path = window.location.pathname.toLowerCase();
                if (path.startsWith('/auth/login') || path.startsWith('/auth/register')) {
                    sessionStorage.setItem('petshop_tab_role', 'Guest');
                    return;
                }

                var url = new URL(window.location.href);
                var urlRole = url.searchParams.get('role') || url.searchParams.get('asRole');
                var tabRole = sessionStorage.getItem('petshop_tab_role');

                if (urlRole) {
                    sessionStorage.setItem('petshop_tab_role', urlRole);
                } else if (tabRole) {
                    url.searchParams.set('role', tabRole);
                    window.location.replace(url.toString());
                } else {
                    sessionStorage.setItem('petshop_tab_role', 'Guest');
                    url.searchParams.set('role', 'Guest');
                    window.location.replace(url.toString());
                }
            } catch (e) { }
        })();
    </script>
    <!-- Google Fonts: Playfair Display (Brand Serif) + Prompt (Thai Clean Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Minimalist Luxury Design System -->
    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
        .main-container {
            flex: 1;
            padding-bottom: 56px;
        }
    </style>
</head>
<body>
    <!-- 1. Top Mini Bar (Responsive for Phone/Tablet) -->
    <div class="top-mini-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="small d-flex align-items-center gap-2">
                <span class="text-truncate"><i class="bi bi-truck text-warning me-1"></i> ส่งฟรีเมื่อครบ ฿800 (<10kg)</span>
                <span class="d-none d-md-inline text-secondary">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-telephone me-1"></i> 02-999-8888</span>
            </div>
            <div class="d-flex align-items-center gap-2 small">
                <!-- Multi-Role Switcher: สลับบทบาทผู้ใช้งานทันที -->
                <div class="dropdown">
                    <button class="btn btn-sm py-0 px-2 rounded-pill d-flex align-items-center gap-1" data-bs-toggle="dropdown" style="background: rgba(223,195,168,0.2); color: #DFC3A8; font-size: 0.72rem; border: 1px solid rgba(223,195,168,0.35);" title="สลับบทบาทผู้ใช้งาน (Multi-Role)">
                        <i class="bi bi-layers-half text-warning"></i>
                        <span class="d-none d-md-inline">Multi-Role</span>
                        <i class="bi bi-chevron-down" style="font-size: 0.6rem;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm small p-2" style="min-width: 240px; font-size: 0.8rem;">
                        <li class="dropdown-header text-uppercase text-lux-muted" style="font-size: 0.65rem;">สลับบทบาทเฉพาะแท็บนี้ (Multi-Role)</li>
                        <li><a class="dropdown-item py-1 rounded" href="/?role=Guest"><i class="bi bi-globe me-2 text-muted"></i> 🌐 ผู้เยี่ยมชม (Guest)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/?role=Customer"><i class="bi bi-person me-2 text-success"></i> 👤 ลูกค้า (Customer)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Inventory?role=InventoryStaff"><i class="bi bi-boxes me-2 text-primary"></i> 📦 คลังสินค้า (Inventory)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Order?role=OrderStaff"><i class="bi bi-card-checklist me-2 text-info"></i> 📋 คำสั่งซื้อ (Order)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Shipping?role=ShippingStaff"><i class="bi bi-truck me-2 text-warning"></i> 🚚 จัดส่งสินค้า (Shipping)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Marketing?role=MarketingStaff"><i class="bi bi-tags me-2 text-danger"></i> 🏷️ โปรโมชั่น (Marketing)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Accounting?role=AccountingStaff"><i class="bi bi-cash-coin me-2 text-success"></i> 💰 การเงิน/บัญชี (ACC)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Support?role=ITSupport"><i class="bi bi-headset me-2 text-primary"></i> 🎧 IT Support (Helpdesk)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Admin?role=Admin"><i class="bi bi-person-gear me-2 text-secondary"></i> ⚙️ ผู้ดูแลระบบ (Admin)</a></li>
                        <li><a class="dropdown-item py-1 rounded" href="/Owner?role=Owner"><i class="bi bi-graph-up-arrow me-2 text-lux-gold"></i> 👑 เจ้าของร้าน (Owner)</a></li>
                    </ul>
                </div>

                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle d-flex align-items-center gap-1 px-2 py-1 rounded-pill" data-bs-toggle="dropdown" style="outline: none;">
                            <i class="bi bi-person-circle text-lux-gold"></i>
                            <span class="d-none d-sm-inline">@fullName</span>
                            @if (isStaffOrAdmin)
                            {
