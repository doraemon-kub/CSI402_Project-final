                            <i class="bi bi-box-seam me-1"></i> ออเดอร์ของฉัน
                        </a>
                    }

                    <a asp-controller="Cart" asp-action="Index" class="btn btn-pet-primary position-relative px-3 py-2">
                        <i class="bi bi-bag me-1"></i> ตะกร้าสินค้า
                        <span class="badge-cart">@cartCount</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- 3. Global Notification Flash Message -->
    @if (!string.IsNullOrEmpty(flashSuccess))
    {
        <div class="container mt-2 mb-0">
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 py-2 px-3 small d-flex align-items-center justify-content-between mb-0" role="alert">
                <div class="d-flex align-items-center me-2">
                    <i class="bi bi-check-circle-fill me-2 text-success fs-6"></i>
                    <span>@flashSuccess</span>
                </div>
                <button type="button" class="btn-close position-static p-1 m-0" data-bs-dismiss="alert" aria-label="Close" style="width: 0.75rem; height: 0.75rem; flex-shrink: 0;"></button>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(flashError))
    {
        <div class="container mt-2 mb-0">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 py-2 px-3 small d-flex align-items-center justify-content-between mb-0" role="alert">
                <div class="d-flex align-items-center me-2">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger fs-6"></i>
                    <span>@flashError</span>
                </div>
                <button type="button" class="btn-close position-static p-1 m-0" data-bs-dismiss="alert" aria-label="Close" style="width: 0.75rem; height: 0.75rem; flex-shrink: 0;"></button>
