@using CSI402_Project_final.Models
@using System.Security.Claims
@inject CSI402_Project_final.Models.PetShopRepository Repo
@{
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var currentUsername = User.Identity?.Name ?? "";
    var currentRoleName = User.FindFirstValue(ClaimTypes.Role) ?? "Guest";
    var fullName = User.FindFirst("FullName")?.Value ?? currentUsername;
    var cartCount = Repo.CurrentCart.TotalItemCount;
    var isStaffOrAdmin = isAuthenticated && currentRoleName != "Customer" && currentRoleName != "Guest";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PetStore Pro</title>
    <!-- Google Fonts: Playfair Display (Brand Serif) + Prompt (Thai Clean Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Minimalist Luxury Design System -->
    <link rel="stylesheet" href="~/css/luxury-theme.css" asp-append-version="true" />
    
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }
        .main-container {
            flex: 1;
            padding-bottom: 56px;
        }
    </style>
</head>
<body>
    <!-- 1. Top Mini Bar (Responsive for Phone/Tablet) -->
    <div class="top-mini-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="small d-flex align-items-center gap-2">
                <span class="text-truncate"><i class="bi bi-truck text-warning me-1"></i> ส่งฟรีเมื่อครบ ฿800 (<10kg)</span>
                <span class="d-none d-md-inline text-secondary">|</span>
                <span class="d-none d-md-inline"><i class="bi bi-telephone me-1"></i> 02-999-8888</span>
            </div>
            <div class="d-flex align-items-center gap-2 small">
                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle d-flex align-items-center gap-1 px-2 py-1 rounded-pill" data-bs-toggle="dropdown" style="outline: none;">
                            <i class="bi bi-person-circle text-lux-gold"></i>
                            <span class="d-none d-sm-inline">@fullName</span>
                            <span class="badge rounded-pill px-2" style="background: var(--lux-gold); color: #fff; font-size: 0.65rem; font-weight: 500;">@currentRoleName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end mt-2">
                            <li class="px-3 py-2 mb-1 rounded-3 bg-lux-tint" style="border-bottom: 1px solid var(--lux-border);">
                                <div class="small fw-semibold text-lux-espresso text-truncate" style="max-width: 200px;">@fullName</div>
                                <div class="text-lux-muted" style="font-size: 0.72rem;">@currentRoleName</div>
                            </li>
                            @if (isStaffOrAdmin)
                            {
                                <li>
                                    <a class="dropdown-item py-2 text-primary fw-bold" 
                                       asp-controller="@(currentRoleName == "InventoryStaff" ? "Inventory" : 
                                                         currentRoleName == "OrderStaff" ? "Order" : 
                                                         currentRoleName == "ShippingStaff" ? "Shipping" : 
                                                         currentRoleName == "MarketingStaff" ? "Marketing" : 
                                                         currentRoleName == "AccountingStaff" ? "Accounting" : 
                                                         currentRoleName == "ITSupport" ? "Support" : 
                                                         currentRoleName == "Admin" ? "Admin" : "Owner")" 
                                       asp-action="Index">
                                        <i class="bi bi-speedometer2 me-2"></i> ระบบจัดการหลังบ้าน
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-gear me-2 text-primary"></i> ข้อมูลส่วนตัวและที่อยู่
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Account" asp-action="Orders">
                                    <i class="bi bi-clock-history me-2 text-muted"></i> ประวัติคำสั่งซื้อ
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Account" asp-action="Support">
                                    <i class="bi bi-headset me-2 text-muted"></i> แจ้งปัญหา (Helpdesk)
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> ออกจากระบบ
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login" class="d-flex align-items-center gap-1">
                        <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ
                    </a>
                    <span class="text-secondary">/</span>
                    <a asp-controller="Auth" asp-action="Register" class="text-warning">
                        สมัครสมาชิก
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- 2. Main Navigation Bar with Mobile Quick Actions -->
    <nav class="navbar navbar-expand-lg navbar-main sticky-top">
        <div class="container">
            <a class="pet-brand" asp-controller="Home" asp-action="Index">
                <span class="pet-brand-mark"><i class="bi bi-heart-fill"></i></span>
                <span>PetStore <span class="text-lux-gold">Pro</span></span>
            </a>

            <!-- Mobile Quick Actions: Cart Button Outside Collapse on Small Screens -->
            <div class="d-flex align-items-center gap-2 d-lg-none">
                <a asp-controller="Cart" asp-action="Index" class="btn btn-pet-primary position-relative px-3 py-1" style="font-size: 0.8rem;">
                    <i class="bi bi-bag"></i>
                    <span class="badge-cart">@cartCount</span>
                </a>
                <button class="navbar-toggler p-2 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1 mt-3 mt-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            สินค้าทั้งหมด
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Dog">
                            สุนัข
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Cat">
                            แมว
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Other">
                            สัตว์เลี้ยงอื่นๆ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-promo fw-medium" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-stars me-1"></i> โปรโมชั่น 5 แบบ
                        </a>
                    </li>
                </ul>

                <!-- Desktop Quick Actions -->
                <div class="d-none d-lg-flex align-items-center gap-2">
                    @if (isStaffOrAdmin)
                    {
                        <a asp-controller="@(currentRoleName == "InventoryStaff" ? "Inventory" : 
                                            currentRoleName == "OrderStaff" ? "Order" : 
                                            currentRoleName == "ShippingStaff" ? "Shipping" : 
                                            currentRoleName == "MarketingStaff" ? "Marketing" : 
                                            currentRoleName == "AccountingStaff" ? "Accounting" : 
                                            currentRoleName == "ITSupport" ? "Support" : 
                                            currentRoleName == "Admin" ? "Admin" : "Owner")" 
                           asp-action="Index" class="btn btn-lux-outline btn-sm px-3 py-2">
                            <i class="bi bi-grid-1x2-fill text-lux-gold me-1"></i> ระบบหลังบ้าน
                        </a>
                    }
                    else if (isAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Orders" class="btn btn-lux-outline btn-sm px-3 py-2">
                            <i class="bi bi-box-seam me-1"></i> ออเดอร์ของฉัน
                        </a>
                    }

                    <a asp-controller="Cart" asp-action="Index" class="btn btn-pet-primary position-relative px-3 py-2">
                        <i class="bi bi-bag me-1"></i> ตะกร้าสินค้า
                        <span class="badge-cart">@cartCount</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- 3. Global Notification Flash Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 py-2 small" role="alert">
                <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 py-2 small" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- 4. Content Area -->
    <main class="main-container">
        @RenderBody()
    </main>

    <!-- 5. Fully Responsive E-Commerce Footer -->
    <footer class="site-footer">
        <div class="container pb-4">
            <div class="row g-4">
                <!-- Col 1: About -->
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="pet-brand text-white mb-2" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-bag-heart-fill text-warning"></i> PetStore Pro
                    </a>
                    <p class="small text-white-50 pe-md-4 mt-2">
                        แหล่งรวมอาหาร ขนม และของใช้สัตว์เลี้ยงเกรดพรีเมียม ตอบโจทย์ทุกช่วงวัย พร้อมระบบคำนวณโปรโมชั่นและค่าจัดส่งตามน้ำหนักอัตโนมัติ
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-btn" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-btn" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-btn" title="Line"><i class="bi bi-line"></i></a>
                        <a href="#" class="social-btn" title="TikTok"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <!-- Col 2: Categories -->
                <div class="col-6 col-md-6 col-lg-2 footer-links">
                    <h6 class="footer-title">หมวดหมู่สินค้า</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Dog">อาหารสุนัข</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-petType="@PetCategory.Cat">อาหารแมว</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-category="@ProductCategory.Hygiene">ทรายแมว</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-category="@ProductCategory.Supply">ของเล่น/เบาะนอน</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-route-specialNeed="โรคไต">อาหารโรคไต</a></li>
                    </ul>
                </div>

                <!-- Col 3: Customer Service -->
                <div class="col-6 col-md-6 col-lg-3 footer-links">
                    <h6 class="footer-title">บริการ & ช่วยเหลือ</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Account" asp-action="Orders">ติดตามสถานะพัสดุ</a></li>
                        <li><a asp-controller="Account" asp-action="Support">แจ้งปัญหาการใช้งาน</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">เงื่อนไขโปรโมชั่น</a></li>
                        @if (!isAuthenticated)
                        {
                            <li><a asp-controller="Auth" asp-action="Login" class="text-warning">เข้าสู่ระบบพนักงาน / สมาชิก</a></li>
                        }
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="footer-title">ติดต่อเรา</h6>
                    <ul class="list-unstyled small text-white-50 mb-3">
                        <li class="mb-1"><i class="bi bi-geo-alt text-warning me-2"></i> จตุจักร กรุงเทพฯ 10900</li>
                        <li class="mb-1"><i class="bi bi-envelope text-warning me-2"></i> contact@petstorepro.com</li>
                        <li><i class="bi bi-clock text-warning me-2"></i> 08:00 - 21:00 น. ทุกวัน</li>
                    </ul>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">PromptPay</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Visa/Mastercard</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Flash</span>
                        <span class="badge bg-secondary py-1 px-2" style="font-size: 0.7rem;">Kerry</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="bottom-bar">
            <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 text-white-50 small text-center text-sm-start">
                <div>© 2026 PetStore Pro. All rights reserved. (Activity 2 CSI402)</div>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a href="#" class="text-white-50 text-decoration-none">นโยบายความเป็นส่วนตัว</a>
                    <span>•</span>
                    <a href="#" class="text-white-50 text-decoration-none">ข้อกำหนดการใช้งาน</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Real-time Live Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="liveRealtimeToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2" id="liveRealtimeToastBody">
                    <i class="bi bi-broadcast text-warning fs-5"></i>
                    <span>กำลังเชื่อมต่อสัญญาณ Real-time...</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Microsoft SignalR JavaScript Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        // เริ่มต้นการเชื่อมต่อ SignalR WebSocket
        const petShopConnection = new signalR.HubConnectionBuilder()
            .withUrl("/petShopHub")
            .withAutomaticReconnect()
            .build();

        // 1. รับการอัปเดตจำนวนคนใส่ตะกร้าแบบ Real-time (Req 8)
        petShopConnection.on("ReceiveCartCountUpdate", function (productId, newCount) {
            const countValEl = document.getElementById(`cart-count-val-${productId}`);
            const badgeEl = document.getElementById(`cart-count-badge-${productId}`);
            if (countValEl) {
                countValEl.innerText = newCount;
                if (badgeEl) {
                    badgeEl.classList.add("lux-glass-pill-pulse");
                    setTimeout(() => {
                        badgeEl.classList.remove("lux-glass-pill-pulse");
                    }, 1200);
                }
            }
        });

        // รับการอัปเดตจำนวนสต็อกคงเหลือแบบ Real-time (ลดเมื่อใส่ตะกร้า และคืนเมื่อเอาออก)
        petShopConnection.on("ReceiveStockUpdate", function (productId, remainingStock) {
            updateProductStockUI(productId, remainingStock);
        });

        function updateProductStockUI(productId, remainingStock) {
            const stockValEl = document.getElementById(`stock-val-${productId}`);
            if (stockValEl) {
                stockValEl.textContent = remainingStock;
            }
            const container = document.getElementById(`stock-badge-container-${productId}`);
            const addBtn = document.getElementById(`add-cart-btn-${productId}`);
            const qtyInput = document.getElementById(`qty-input-${productId}`);

            if (qtyInput) {
                qtyInput.max = remainingStock;
                if (parseInt(qtyInput.value) > remainingStock) {
                    qtyInput.value = Math.max(1, remainingStock);
                }
            }

            if (remainingStock <= 0) {
                if (container) {
                    container.innerHTML = '<span class="lux-stock-pill lux-stock-out"><span class="lux-stock-dot"></span> สินค้าหมด</span>';
                }
                if (addBtn) {
                    addBtn.disabled = true;
                    addBtn.className = 'btn btn-secondary w-100 btn-sm rounded-3';
                    addBtn.innerHTML = '<i class="bi bi-x-circle me-1"></i> หมดสต็อก';
                }
            } else if (remainingStock <= 5) {
                if (container) {
                    container.innerHTML = `<span class="lux-stock-pill lux-stock-low"><span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-${productId}">${remainingStock}</strong> ชิ้น</span>`;
                }
                if (addBtn && addBtn.disabled) {
                    addBtn.disabled = false;
                    addBtn.className = 'btn btn-pet-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1';
                    addBtn.innerHTML = '<i class="bi bi-bag-plus"></i> <span>เพิ่มลงตะกร้า</span>';
                }
            } else {
                if (container) {
                    container.innerHTML = `<span class="lux-stock-pill lux-stock-ok"><span class="lux-stock-dot"></span> เหลือ <strong id="stock-val-${productId}">${remainingStock}</strong> ชิ้น</span>`;
                }
                if (addBtn && addBtn.disabled) {
                    addBtn.disabled = false;
                    addBtn.className = 'btn btn-pet-primary w-100 btn-sm d-flex align-items-center justify-content-center gap-1';
                    addBtn.innerHTML = '<i class="bi bi-bag-plus"></i> <span>เพิ่มลงตะกร้า</span>';
                }
            }
        }

        // 2. รับแจ้งเตือนเมื่อพัสดุจัดส่งแล้ว
        petShopConnection.on("ReceiveOrderShippedAlert", function (orderId, trackingNumber, courier) {
            showRealtimeToast(`🚚 ออเดอร์ #${orderId} ถูกจัดส่งแล้ว! (${courier}: ${trackingNumber})`);
        });

        // 3. รับแจ้งเตือนเมื่อมีออเดอร์ใหม่
        petShopConnection.on("ReceiveNewOrderAlert", function (orderId, customerName, grandTotal) {
            showRealtimeToast(`🎉 มีคำสั่งซื้อใหม่ #${orderId} จาก ${customerName} (฿${grandTotal})`);
        });

        petShopConnection.start().catch(err => console.log("SignalR Connection Error: ", err));

        function showRealtimeToast(message) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `<i class="bi bi-bell-fill text-warning fs-5"></i> <span>${message}</span>`;
                const bsToast = new bootstrap.Toast(toastEl, { delay: 5000 });
                bsToast.show();
            }
        }
        // 4. ระบบเพิ่มสินค้าลงตะกร้าแบบ AJAX ลื่นไหลโดยไม่ต้องโหลดหน้าเว็บใหม่ (Smooth Add to Cart)
        document.addEventListener('submit', async function (e) {
            const form = e.target.closest('form.ajax-add-to-cart, form[action*="/Cart/Add"]');
            if (!form) return;

            e.preventDefault();

            const submitBtn = form.querySelector('button[type="submit"]');
            const originalHtml = submitBtn ? submitBtn.innerHTML : '';

            // แสดงสถานะปุ่มกำลังประมวลผล
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> เพิ่ม...';
            }

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                if (response.ok) {
                    const data = await response.json();

                    // กรณีที่ผู้ใช้ยังไม่ได้ล็อกอิน (Guest) นำทางไปหน้าเข้าสู่ระบบทันที
                    if (data.requireLogin) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalHtml;
                        }
                        showWarningToast(data.message || 'กรุณาเข้าสู่ระบบก่อนหยิบสินค้าลงในตะกร้า');
                        setTimeout(() => {
                            window.location.href = data.redirectUrl || '/Auth/Login';
                        }, 1000);
                        return;
                    }

                    if (!data.success) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalHtml;
                        }
                        showWarningToast(data.message || 'ไม่สามารถเพิ่มสินค้าลงในตะกร้าได้');
                        return;
                    }

                    // 1. อัปเดตตัวเลขตะกร้าสินค้าในแถบเมนูด้านบนทั้ง Mobile และ Desktop พร้อมเอฟเฟกต์เด้ง (Bounce)
                    document.querySelectorAll('.badge-cart').forEach(badge => {
                        badge.textContent = data.cartCount;
                        badge.classList.remove('badge-bump');
                        void badge.offsetWidth; // trigger reflow
                        badge.classList.add('badge-bump');
                    });

                    // 2. อัปเดตจำนวนคนใส่ตะกร้าบนการ์ดสินค้าทันที (Req 8 Real-time count)
                    const countValEl = document.getElementById(`cart-count-val-${data.productId}`);
                    if (countValEl) {
                        countValEl.textContent = data.productCartCount;
                    }

                    // 3. อัปเดตจำนวนสต็อกคงเหลือบนการ์ดสินค้าทันที (ลดลงเมื่อใส่ตะกร้า)
                    if (typeof data.remainingStock !== 'undefined') {
                        updateProductStockUI(data.productId, data.remainingStock);
                    }

                    // 4. เปลี่ยนสถานะปุ่มเป็นเครื่องหมายถูกสีเขียวชั่วขณะ
                    if (submitBtn) {
                        submitBtn.classList.remove('btn-pet-primary');
                        submitBtn.classList.add('btn-success');
                        submitBtn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> เพิ่มแล้ว!';

                        setTimeout(() => {
                            submitBtn.classList.remove('btn-success');
                            submitBtn.classList.add('btn-pet-primary');
                            submitBtn.innerHTML = originalHtml;
                            submitBtn.disabled = false;
                        }, 1200);
                    }

                    // 4. แสดง Toast แจ้งเตือนแบบลื่นไหลมุมขวาล่าง
                    showCartToast(data.productName || 'สินค้า', data.cartCount);
                } else {
                    form.submit();
                }
            } catch (err) {
                console.error('AJAX add to cart failed, fallback to submit:', err);
                form.submit();
            }
        });

        function showCartToast(productName, cartCount) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-success rounded-circle text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="bi bi-cart-check-fill fs-6"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-white small">เพิ่มลงในตะกร้าแล้ว!</div>
                            <div class="text-white-50 text-truncate" style="font-size: 0.75rem;">${productName} (ในตะกร้ามี ${cartCount} ชิ้น)</div>
                        </div>
                    </div>`;
                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 });
                bsToast.show();
            }
        }

        function showWarningToast(message) {
            const toastEl = document.getElementById('liveRealtimeToast');
            const toastBody = document.getElementById('liveRealtimeToastBody');
            if (toastEl && toastBody) {
                toastBody.innerHTML = `
                    <div class="d-flex align-items-center gap-2">
                        <div class="p-2 bg-warning rounded-circle text-dark d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="bi bi-shield-lock-fill fs-6"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="fw-bold text-white small">แจ้งเตือนจากระบบ</div>
                            <div class="text-white small text-truncate" style="font-size: 0.8rem;">${message}</div>
                        </div>
                    </div>`;
                const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 4000 });
                bsToast.show();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
