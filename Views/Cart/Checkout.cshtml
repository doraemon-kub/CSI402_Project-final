@model CSI402_Project_final.Models.Cart
@using System.Security.Claims
@inject CSI402_Project_final.Models.PetShopRepository Repo
@{
    ViewData["Title"] = "ชำระเงินและระบุที่อยู่จัดส่ง";
    var username = User.Identity?.Name ?? "";
    var user = Repo.GetUserByUsername(username);
    var defaultAddrObj = user?.DefaultAddress;
    var defaultName = !string.IsNullOrWhiteSpace(defaultAddrObj?.RecipientName) ? defaultAddrObj.RecipientName : (user?.FullName ?? "คุณลูกค้าสมาชิก");
    var defaultPhone = !string.IsNullOrWhiteSpace(defaultAddrObj?.Phone) ? defaultAddrObj.Phone : (user?.Phone ?? "081-234-5678");
    var defaultAddress = defaultAddrObj?.DisplayAddress ?? "กรุงเทพมหานคร 10100";
    var savedAddresses = user?.Addresses ?? new List<CSI402_Project_final.Models.UserAddress>();
    var promptPayPayload = ViewBag.PromptPayPayload as string ?? "PETSTOREPRO";
    var qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=180x180&data={Uri.EscapeDataString(promptPayPayload)}";
}

<div class="container pt-2 pt-md-3 pb-4 pb-md-5" style="max-width: 960px;">
    <div class="mb-4">
        <div class="text-uppercase fw-semibold text-lux-gold mb-1" style="font-size: 0.72rem; letter-spacing: 0.1em;">CHECKOUT</div>
        <h3 class="fw-bold text-lux-espresso m-0">ยืนยันการสั่งซื้อและชำระเงิน</h3>
    </div>

    <div class="row g-4">
        <!-- ฟอร์มที่อยู่และการชำระเงิน -->
        <div class="col-md-7">
            <div class="lux-card p-4 p-md-5 mb-4">
                <h5 class="fw-bold text-lux-espresso mb-3">
                    <i class="bi bi-geo-alt text-lux-gold me-2"></i>ข้อมูลผู้รับและที่อยู่จัดส่ง
                </h5>
                <form asp-action="SubmitOrder" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label small fw-medium text-lux-muted">ชื่อ-นามสกุล ผู้รับ</label>
                        <input type="text" name="customerName" id="checkoutCustomerName" class="form-control" value="@defaultName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-medium text-lux-muted">เบอร์โทรศัพท์ติดต่อ</label>
                        <input type="tel" name="customerPhone" id="checkoutCustomerPhone" class="form-control" value="@defaultPhone" required />
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-medium text-lux-muted mb-0">ที่อยู่จัดส่งสินค้า</label>
                            <button type="button" class="btn btn-link p-0 small text-lux-gold text-decoration-none fw-medium" data-bs-toggle="modal" data-bs-target="#addressBookModal">
                                <i class="bi bi-journal-bookmark-fill me-1"></i>จัดการสมุดที่อยู่ (@savedAddresses.Count)
                            </button>
                        </div>
                        <textarea name="shippingAddress" id="checkoutShippingAddress" class="form-control" rows="3" required>@defaultAddress</textarea>
                    </div>

                    <hr class="my-4" style="border-color: var(--lux-border);" />

                    <h5 class="fw-bold text-lux-espresso mb-3">
                        <i class="bi bi-truck text-lux-gold me-2"></i>บริษัทขนส่ง (วิธีจัดส่ง)
                    </h5>
                    <div class="mb-4">
                        <label class="form-label small fw-medium text-lux-muted">เลือกผู้ให้บริการขนส่งพัสดุ</label>
                        <select name="courier" id="courierSelect" class="form-select" onchange="updateCourierSelection(this.value)" required>
                            <option value="Flash Express" data-surcharge="0" selected>⚡ Flash Express (จัดส่งด่วนทั่วประเทศ 1-2 วัน) — ค่าจัดส่งปกติ (฿@Model.ShippingFee.ToString("N0"))</option>
                            <option value="Kerry Express" data-surcharge="0">🚚 Kerry Express (บริการส่งด่วนถึงหน้าบ้าน 1-2 วัน) — ค่าจัดส่งปกติ (฿@Model.ShippingFee.ToString("N0"))</option>
                            <option value="ไปรษณีย์ไทย (EMS)" data-surcharge="30">📮 ไปรษณีย์ไทย (Thailand Post - EMS ด่วนพิเศษ) — ด่วนพิเศษ (+฿30)</option>
                        </select>
                    </div>

                    <hr class="my-4" style="border-color: var(--lux-border);" />

                    <h5 class="fw-bold text-lux-espresso mb-3">
                        <i class="bi bi-qr-code text-lux-gold me-2"></i>ช่องทางการชำระเงิน
                    </h5>
                    <div class="mb-3">
                        <label class="form-label small fw-medium text-lux-muted">เลือกวิธีการชำระเงิน</label>
                        <select name="paymentMethod" id="paymentMethodSelect" class="form-select" onchange="togglePaymentSection()">
                            <option value="โอนผ่านธนาคาร / PromptPay" selected>โอนผ่านธนาคาร / สแกน PromptPay (แนบสลิป)</option>
                            <option value="เก็บเงินปลายทาง (COD)">เก็บเงินปลายทาง (COD)</option>
                        </select>
                    </div>

                    <div id="bankTransferBox">
                        <div class="p-4 rounded-4 bg-lux-tint mb-3 text-center" style="border: 1px solid var(--lux-border);">
                            <div class="small fw-medium text-lux-muted mb-2">สแกน PromptPay QR Code (ระบุยอดชำระอัตโนมัติ)</div>
                            <img id="promptPayQrImg" src="@qrImageUrl" class="rounded-3 bg-white p-2 mb-2 shadow-sm" style="width: 168px; height: 168px; border: 1px solid var(--lux-border);" alt="PromptPay QR" />
                            <div class="small text-lux-muted">พร้อมเพย์: 081-234-5678 · บจก. เพ็ทสโตร์ โปร</div>
                            <div class="fw-bold text-lux-espresso fs-5 mt-1">ยอดชำระ: <span id="promptPayTotalText">฿@Model.GrandTotal.ToString("N2")</span></div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-medium text-lux-muted">แนบหลักฐานสลิปการโอนเงิน (JPG, PNG, WEBP ไม่เกิน 5MB) <span class="text-danger">*</span></label>
                            <input type="file" name="paymentSlip" id="paymentSlipInput" class="form-control" accept="image/*" required />
                            <div class="small text-lux-muted mt-2">
                                <i class="bi bi-shield-check text-lux-gold me-1"></i>คำสั่งซื้อจะเข้าสู่สถานะ <strong>รอฝ่ายบัญชีตรวจสอบสลิป</strong> (ไม่สามารถเปลี่ยนรูปสลิปภายหลังได้)
                            </div>
                        </div>
                    </div>

                    <div id="codNoticeBox" class="p-3 rounded-3 bg-lux-tint small d-none mb-4" style="border: 1px solid var(--lux-border-strong);">
                        <i class="bi bi-truck text-lux-gold me-1"></i> เลือกชำระเงินปลายทาง (COD): กรุณาเตรียมชำระเงินจำนวน <strong id="codTotalText">฿@Model.GrandTotal.ToString("N2")</strong> กับพนักงานขนส่ง
                    </div>

                    <button type="submit" class="btn btn-pet-primary btn-lg w-100 py-3">
                        <i class="bi bi-check2-circle me-1"></i> ยืนยันการสั่งซื้อทันที
                    </button>
                </form>
            </div>
        </div>

        <!-- สรุปตะกร้าด้านข้าง -->
        <div class="col-md-5">
            <div class="lux-card p-4 sticky-top" style="top: 96px;">
                <div class="text-uppercase fw-semibold text-lux-gold mb-1" style="font-size: 0.7rem; letter-spacing: 0.1em;">ITEMS IN BAG</div>
                <h6 class="fw-bold mb-3 text-lux-espresso">สรุปรายการคำสั่งซื้อ</h6>
                <div class="small mb-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-lux-muted">@item.Product.Name <span class="text-lux-espresso fw-medium">(x@(item.Quantity))</span></span>
                            <span class="fw-semibold text-lux-espresso">฿@item.Subtotal.ToString("N0")</span>
                        </div>
                    }
                </div>

                <hr class="my-3" style="border-color: var(--lux-border);" />
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-lux-muted">บริษัทขนส่งที่เลือก</span>
                    <span class="fw-semibold text-lux-espresso" id="summaryCourierText">Flash Express</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-lux-muted">น้ำหนักสินค้ารวม</span>
                    <span class="fw-semibold text-lux-espresso">@Model.TotalWeightKg kg</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-lux-muted">ส่วนลดโปรโมชั่น</span>
                    <span class="fw-semibold lux-price-sale">-฿@Model.TotalPromotionDiscount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-lux-muted">
                        ค่าจัดส่ง
                        <span id="emsBadge" class="badge bg-danger-subtle text-danger ms-1 d-none" style="font-size: 0.68rem;">EMS ด่วนพิเศษ +฿30</span>
                    </span>
                    <span class="fw-semibold text-lux-espresso" id="summaryShippingFee">฿@Model.ShippingFee.ToString("N2")</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.FreeGiftItem))
                {
                    <div class="d-flex justify-content-between small mb-2 text-lux-gold">
                        <span>ของแถมฟรี</span>
                        <span class="fw-semibold">@Model.FreeGiftItem</span>
                    </div>
                }

                <hr class="my-3" style="border-color: var(--lux-border);" />
                <div class="d-flex justify-content-between align-items-baseline">
                    <span class="fw-bold text-lux-espresso">ยอดสุทธิ</span>
                    <span class="fs-4 fw-bold text-lux-espresso" id="summaryGrandTotal">฿@Model.GrandTotal.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal สมุดที่อยู่จัดส่ง (เลือกเปลี่ยนที่อยู่ได้ทันทีไม่ต้องออกจากหน้า Checkout) -->
<div class="modal fade" id="addressBookModal" tabindex="-1" aria-labelledby="addressBookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom px-4 py-3" style="background: var(--lux-tint);">
                <div>
                    <h5 class="modal-title fw-bold text-lux-espresso m-0" id="addressBookModalLabel">
                        <i class="bi bi-geo-alt-fill text-lux-gold me-2"></i>เลือกที่อยู่จัดส่งจากสมุดที่อยู่
                    </h5>
                    <div class="small text-lux-muted">คลิกเลือกที่อยู่ที่เคยบันทึกไว้เพื่อเปลี่ยนข้อมูลผู้รับและที่อยู่จัดส่งทันที</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- รายการที่อยู่ที่บันทึกไว้ -->
                <div id="savedAddressListContainer" class="d-flex flex-column gap-3 mb-3">
                    @if (savedAddresses.Any())
                    {
                        foreach (var addr in savedAddresses.OrderByDescending(a => a.IsDefault))
                        {
                            var rName = !string.IsNullOrWhiteSpace(addr.RecipientName) ? addr.RecipientName : defaultName;
                            var rPhone = !string.IsNullOrWhiteSpace(addr.Phone) ? addr.Phone : defaultPhone;
                            var rDisplay = addr.DisplayAddress;
                            var isCurrent = rDisplay == defaultAddress;
                            <div class="p-3 rounded-4 border address-choice-card @(isCurrent ? "border-warning bg-lux-tint" : "bg-white")"
                                 style="cursor: pointer; transition: all 0.15s ease;"
                                 data-recipient="@rName"
                                 data-phone="@rPhone"
                                 data-address="@rDisplay"
                                 onclick="selectSavedAddress(this)">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="badge bg-dark rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-house-door me-1"></i>@addr.Title
                                            </span>
                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size: 0.7rem;">ที่อยู่หลัก</span>
                                            }
                                            <span class="fw-bold text-lux-espresso small">@rName</span>
                                            <span class="text-lux-muted small">(@rPhone)</span>
                                        </div>
                                        <div class="small text-secondary mt-1">@rDisplay</div>
                                    </div>
                                    <button type="button" class="btn btn-sm @(isCurrent ? "btn-warning text-dark fw-semibold" : "btn-outline-dark") rounded-pill px-3 flex-shrink-0 select-addr-btn">
                                        @(isCurrent ? "กำลังเลือกใช้" : "เลือกใช้ที่อยู่นี้")
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="emptyAddressState" class="text-center py-4 text-lux-muted small">
                            <i class="bi bi-journal-x fs-2 d-block mb-2 text-secondary"></i>
                            ยังไม่มีที่อยู่ที่บันทึกไว้ในสมุดที่อยู่ คุณสามารถกดเพิ่มที่อยู่ใหม่ด้านล่างได้ทันที
                        </div>
                    }
                </div>

                <!-- ปุ่มเปิดฟอร์มเพิ่มที่อยู่ใหม่ด่วน -->
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <button class="btn btn-sm btn-outline-dark rounded-pill px-3" type="button" data-bs-toggle="collapse" data-bs-target="#quickAddAddressCollapse">
                        <i class="bi bi-plus-circle me-1"></i> เพิ่มที่อยู่จัดส่งใหม่
                    </button>
                    <a asp-controller="Account" asp-action="Profile" class="small text-lux-muted text-decoration-none">
                        <i class="bi bi-box-arrow-up-right me-1"></i>ไปหน้าจัดการข้อมูลส่วนตัวและที่อยู่ทั้งหมด
                    </a>
                </div>

                <!-- ฟอร์มเพิ่มที่อยู่ใหม่ด่วนภายใน Modal -->
                <div class="collapse mt-3" id="quickAddAddressCollapse">
                    <div class="p-3 rounded-4 bg-light border">
                        <h6 class="fw-bold text-lux-espresso mb-3 small">
                            <i class="bi bi-plus-square-fill text-lux-gold me-1"></i> เพิ่มที่อยู่ใหม่ลงในสมุดที่อยู่
                        </h6>
                        <div id="quickAddrError" class="alert alert-danger py-1 px-2 small d-none mb-2"></div>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">ป้ายกำกับที่อยู่</label>
                                <input type="text" id="newAddrTitle" class="form-control form-control-sm" value="ที่อยู่บ้าน" placeholder="เช่น บ้าน, ที่ทำงาน" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">ชื่อ-นามสกุล ผู้รับ</label>
                                <input type="text" id="newAddrRecipient" class="form-control form-control-sm" value="@defaultName" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">เบอร์โทรศัพท์ผู้รับ</label>
                                <input type="tel" id="newAddrPhone" class="form-control form-control-sm" value="@defaultPhone" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1">บ้านเลขที่ ซอย หมู่บ้าน ถนน</label>
                                <input type="text" id="newAddrFull" class="form-control form-control-sm" placeholder="เช่น 99/9 หมู่ 4 ถ.พหลโยธิน" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small text-muted mb-1">แขวง/ตำบล</label>
                                <input type="text" id="newAddrSubdistrict" class="form-control form-control-sm" placeholder="เช่น จอมพล" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small text-muted mb-1">เขต/อำเภอ</label>
                                <input type="text" id="newAddrDistrict" class="form-control form-control-sm" placeholder="เช่น จตุจักร" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small text-muted mb-1">จังหวัด</label>
                                <input type="text" id="newAddrProvince" class="form-control form-control-sm" placeholder="เช่น กรุงเทพมหานคร" />
                            </div>
                            <div class="col-md-3 col-6">
                                <label class="form-label small text-muted mb-1">รหัสไปรษณีย์</label>
                                <input type="text" id="newAddrPostal" class="form-control form-control-sm" placeholder="เช่น 10900" />
                            </div>
                            <div class="col-12 mt-2 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3" onclick="saveQuickAddress()">
                                    <i class="bi bi-check2-circle me-1"></i> บันทึกและใช้ที่อยู่นี้ทันที
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const baseShippingFee = @Model.ShippingFee;
        const netProductPrice = @Model.NetProductPrice;

        async function updateCourierSelection(courier) {
            const courierTextEl = document.getElementById('summaryCourierText');
            if (courierTextEl) courierTextEl.textContent = courier;

            const selectEl = document.getElementById('courierSelect');
            const selectedOpt = selectEl ? selectEl.options[selectEl.selectedIndex] : null;
            const surcharge = selectedOpt ? parseFloat(selectedOpt.getAttribute('data-surcharge') || '0') : 0;

            const newShippingFee = baseShippingFee + surcharge;
            const newGrandTotal = netProductPrice + newShippingFee;

            // Instant UI update
            const emsBadge = document.getElementById('emsBadge');
            if (emsBadge) {
                emsBadge.classList.toggle('d-none', surcharge <= 0);
            }
            const feeEl = document.getElementById('summaryShippingFee');
            if (feeEl) feeEl.textContent = '฿' + newShippingFee.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const totalEl = document.getElementById('summaryGrandTotal');
            if (totalEl) totalEl.textContent = '฿' + newGrandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const promptPayText = document.getElementById('promptPayTotalText');
            if (promptPayText) promptPayText.textContent = '฿' + newGrandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const codText = document.getElementById('codTotalText');
            if (codText) codText.textContent = '฿' + newGrandTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Server-verified calculation & updated PromptPay QR
            try {
                const resp = await fetch(`/Cart/GetCourierCalculation?courier=${encodeURIComponent(courier)}`);
                if (resp.ok) {
                    const data = await resp.json();
                    if (data.success) {
                        if (data.qrUrl) {
                            const qrImg = document.getElementById('promptPayQrImg');
                            if (qrImg) qrImg.src = data.qrUrl;
                        }
                        if (feeEl) feeEl.textContent = '฿' + data.formattedShippingFee;
                        if (totalEl) totalEl.textContent = '฿' + data.formattedGrandTotal;
                        if (promptPayText) promptPayText.textContent = '฿' + data.formattedGrandTotal;
                        if (codText) codText.textContent = '฿' + data.formattedGrandTotal;
                    }
                }
            } catch (e) {
                // Fallback already performed smoothly
            }
        }

        function togglePaymentSection() {
            const method = document.getElementById('paymentMethodSelect').value;
            const isCod = method.indexOf('COD') !== -1;
            document.getElementById('bankTransferBox').classList.toggle('d-none', isCod);
            document.getElementById('codNoticeBox').classList.toggle('d-none', !isCod);
            const slipInput = document.getElementById('paymentSlipInput');
            if (slipInput) {
                slipInput.required = !isCod;
            }
        }

        function selectSavedAddress(cardEl) {
            const recipient = cardEl.getAttribute('data-recipient') || '';
            const phone = cardEl.getAttribute('data-phone') || '';
            const address = cardEl.getAttribute('data-address') || '';

            const nameInput = document.getElementById('checkoutCustomerName');
            const phoneInput = document.getElementById('checkoutCustomerPhone');
            const addrInput = document.getElementById('checkoutShippingAddress');

            if (nameInput && recipient) nameInput.value = recipient;
            if (phoneInput && phone) phoneInput.value = phone;
            if (addrInput && address) addrInput.value = address;

            // อัปเดตสถานะการ์ดใน Modal
            document.querySelectorAll('.address-choice-card').forEach(c => {
                c.classList.remove('border-warning', 'bg-lux-tint');
                c.classList.add('bg-white');
                const btn = c.querySelector('.select-addr-btn');
                if (btn) {
                    btn.className = 'btn btn-sm btn-outline-dark rounded-pill px-3 flex-shrink-0 select-addr-btn';
                    btn.textContent = 'เลือกใช้ที่อยู่นี้';
                }
            });

            cardEl.classList.remove('bg-white');
            cardEl.classList.add('border-warning', 'bg-lux-tint');
            const activeBtn = cardEl.querySelector('.select-addr-btn');
            if (activeBtn) {
                activeBtn.className = 'btn btn-sm btn-warning text-dark fw-semibold rounded-pill px-3 flex-shrink-0 select-addr-btn';
                activeBtn.textContent = 'กำลังเลือกใช้';
            }

            // ปิด Modal ทันที
            const modalEl = document.getElementById('addressBookModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
            }
        }

        async function saveQuickAddress() {
            const title = document.getElementById('newAddrTitle').value.trim() || 'ที่อยู่จัดส่ง';
            const recipientName = document.getElementById('newAddrRecipient').value.trim();
            const phone = document.getElementById('newAddrPhone').value.trim();
            const fullAddress = document.getElementById('newAddrFull').value.trim();
            const subdistrict = document.getElementById('newAddrSubdistrict').value.trim();
            const district = document.getElementById('newAddrDistrict').value.trim();
            const province = document.getElementById('newAddrProvince').value.trim();
            const postalCode = document.getElementById('newAddrPostal').value.trim();
            const errBox = document.getElementById('quickAddrError');

            if (!fullAddress || !province) {
                errBox.textContent = 'กรุณากรอกบ้านเลขที่/ที่อยู่ และจังหวัดให้ครบถ้วน';
                errBox.classList.remove('d-none');
                return;
            }
            errBox.classList.add('d-none');

            const formData = new FormData();
            formData.append('Title', title);
            formData.append('RecipientName', recipientName);
            formData.append('Phone', phone);
            formData.append('FullAddress', fullAddress);
            formData.append('Subdistrict', subdistrict);
            formData.append('District', district);
            formData.append('Province', province);
            formData.append('PostalCode', postalCode);
            formData.append('IsDefault', 'true');

            try {
                const resp = await fetch('/Account/SaveAddress', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = await resp.json();
                if (!data.success) {
                    errBox.textContent = data.message || 'ไม่สามารถบันทึกที่อยู่ได้';
                    errBox.classList.remove('d-none');
                    return;
                }

                // สร้างการ์ดใหม่ในรายการแล้วเลือกใช้ทันที
                const emptyEl = document.getElementById('emptyAddressState');
                if (emptyEl) emptyEl.remove();

                const listContainer = document.getElementById('savedAddressListContainer');
                const newCard = document.createElement('div');
                newCard.className = 'p-3 rounded-4 border address-choice-card bg-white';
                newCard.style.cursor = 'pointer';
                newCard.setAttribute('data-recipient', data.recipientName || recipientName);
                newCard.setAttribute('data-phone', data.phone || phone);
                newCard.setAttribute('data-address', data.displayAddress);
                newCard.onclick = function () { selectSavedAddress(newCard); };
                newCard.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge bg-dark rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                                    <i class="bi bi-house-door me-1"></i>${data.title || title}
                                </span>
                                <span class="fw-bold text-lux-espresso small">${data.recipientName || recipientName}</span>
                                <span class="text-lux-muted small">(${data.phone || phone})</span>
                            </div>
                            <div class="small text-secondary mt-1">${data.displayAddress}</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 flex-shrink-0 select-addr-btn">
                            เลือกใช้ที่อยู่นี้
                        </button>
                    </div>`;
                listContainer.prepend(newCard);
                selectSavedAddress(newCard);
            } catch (e) {
                errBox.textContent = 'เกิดข้อผิดพลาดในการบันทึกที่อยู่';
                errBox.classList.remove('d-none');
            }
        }
    </script>
}
