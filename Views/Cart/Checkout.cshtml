@model CSI402_Project_final.Models.Cart
@{
    ViewData["Title"] = "ชำระเงินและระบุที่อยู่จัดส่ง";
}

<div class="container py-4" style="max-width: 900px;">
    <h3 class="fw-bold mb-4 text-dark"><i class="bi bi-credit-card-2-front text-warning"></i> ยืนยันการสั่งซื้อและชำระเงิน</h3>

    <div class="row g-4">
        <!-- ฟอร์มที่อยู่และการชำระเงิน -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt-fill text-danger"></i> ข้อมูลผู้รับและที่อยู่จัดส่ง</h5>
                <form asp-action="SubmitOrder" method="post">
@using System.Security.Claims
@inject CSI402_Project_final.Models.PetShopRepository Repo
@{
    var username = User.Identity?.Name ?? "";
    var user = Repo.GetUserByUsername(username);
    var defaultName = user?.FullName ?? "คุณลูกค้าสมาชิก";
    var defaultPhone = user?.Phone ?? "081-234-5678";
    var defaultAddress = user?.DefaultAddress?.DisplayAddress ?? "กรุงเทพมหานคร 10100";
}
                    <div class="mb-3">
                        <label class="form-label small fw-bold">ชื่อ-นามสกุล ผู้รับ</label>
                        <input type="text" name="customerName" class="form-control" value="@defaultName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">เบอร์โทรศัพท์ติดต่อ</label>
                        <input type="tel" name="customerPhone" class="form-control" value="@defaultPhone" required />
                    </div>
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label small fw-bold">ที่อยู่จัดส่งสินค้า</label>
                            <a asp-controller="Account" asp-action="Profile" class="small text-decoration-none">
                                <i class="bi bi-pencil-square"></i> จัดการสมุดที่อยู่
                            </a>
                        </div>
                        <textarea name="shippingAddress" class="form-control" rows="3" required>@defaultAddress</textarea>
                    </div>

                    <h5 class="fw-bold mb-3"><i class="bi bi-qr-code text-primary"></i> ช่องทางการชำระเงิน (Req 19)</h5>
                    <div class="p-3 border rounded-3 bg-light mb-3 text-center">
                        <div class="small fw-bold text-muted mb-2">สแกนชำระผ่าน PromptPay / ธนาคาร</div>
                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=PETSTOREPRO-PAYMENT-MOCK" class="img-thumbnail mb-2" style="width: 140px;" />
                        <div class="small text-muted">พร้อมเพย์: 081-234-5678 (บจก. เพ็ทสโตร์ โปร)</div>
                        <div class="fw-bold text-danger fs-5 mt-1">ยอดชำระ: ฿@Model.GrandTotal.ToString("N2")</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold">แนบหลักฐานสลิปการโอนเงิน (จำลอง)</label>
                        <input type="file" class="form-control" accept="image/*" />
                        <div class="small text-muted mt-1">* ระบบจำลองจะบันทึกสถานะชำระเงินเรียบร้อยอัตโนมัติ</div>
                    </div>

                    <button type="submit" class="btn btn-pet-primary btn-lg w-100 fw-bold py-3 shadow-sm">
                        <i class="bi bi-check2-circle"></i> ยืนยันการสั่งซื้อทันที
                    </button>
                </form>
            </div>
        </div>

        <!-- สรุปตะกร้าด้านข้าง -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold mb-3 text-dark">สรุปรายการคำสั่งซื้อ</h6>
                <div class="small mb-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.Product.Name (x@item.Quantity)</span>
                            <span class="fw-bold">฿@item.Subtotal.ToString("N0")</span>
                        </div>
                    }
                </div>

                <hr class="my-2" />
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">น้ำหนักสินค้ารวม:</span>
                    <span class="fw-bold">⚖️ @Model.TotalWeightKg kg</span>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">ส่วนลดโปรโมชั่น:</span>
                    <span class="fw-bold text-danger">-฿@Model.TotalPromotionDiscount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between small mb-1">
                    <span class="text-muted">ค่าจัดส่ง:</span>
                    <span class="fw-bold">฿@Model.ShippingFee.ToString("N2")</span>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.FreeGiftItem))
                {
                    <div class="d-flex justify-content-between small mb-1 text-warning">
                        <span>ของแถมฟรี:</span>
                        <span class="fw-bold">@Model.FreeGiftItem</span>
                    </div>
                }

                <hr class="my-3" />
                <div class="d-flex justify-content-between align-items-baseline">
                    <span class="fw-bold fs-6">ยอดสุทธิ:</span>
                    <span class="fs-4 fw-bold text-danger">฿@Model.GrandTotal.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
