@model List<CSI402_Project_final.Models.Order>
@using CSI402_Project_final.Models
@{
    Layout = "_BackOfficeLayout";
    ViewData["Title"] = "7. การเงินและบัญชีร้านค้า (Accounting Staff)";
    var summary = ViewBag.FinancialSummary as FinancialSummary ?? new();
    var pendingRefunds = ViewBag.PendingRefunds as List<Order> ?? new();
}

<!-- Financial Overview Cards (Req 21: จัดทำรายงานรายรับและรายจ่ายของร้าน) -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="text-muted small">รายรับรวมทั้งหมด (Revenue)</div>
            <div class="fs-4 fw-bold text-success mt-1">฿@summary.TotalRevenue.ToString("N2")</div>
            <small class="text-success"><i class="bi bi-arrow-up"></i> จากคำสั่งซื้อทั้งหมด</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="text-muted small">รายจ่ายรวม (Expenses/Cost)</div>
            <div class="fs-4 fw-bold text-secondary mt-1">฿@summary.TotalExpenses.ToString("N2")</div>
            <small class="text-muted">ต้นทุนสินค้า & ค่าบริหาร</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="text-muted small">ยอดคืนเงินลูกค้า (Refunded)</div>
            <div class="fs-4 fw-bold text-danger mt-1">฿@summary.TotalRefunds.ToString("N2")</div>
            <small class="text-danger">อนุมัติคืนเงินแล้ว</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="text-muted small">กำไรสุทธิโดยประมาณ (Net Profit)</div>
            <div class="fs-4 fw-bold text-primary mt-1">฿@summary.NetProfit.ToString("N2")</div>
            <small class="text-primary fw-bold">หักค่าใช้จ่ายและการคืนเงินแล้ว</small>
        </div>
    </div>
</div>

<!-- Pending Refund Requests (Req 20: บันทึกข้อมูลและสถานะการคืนเงิน) -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold m-0 text-dark">
            <i class="bi bi-arrow-counterclockwise text-danger"></i> รายการคำขอคืนเงินที่รอดำเนินการ (Req 20)
            <span class="badge bg-danger ms-2">@pendingRefunds.Count รายการ</span>
        </h5>
    </div>

    @if (!pendingRefunds.Any())
    {
        <div class="p-4 text-center text-muted">ไม่มีคำขอคืนเงินค้างในระบบ</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>เลขออเดอร์</th>
                        <th>ลูกค้า</th>
                        <th>ยอดเงินที่ขอคืน</th>
                        <th>เหตุผลการขอยกเลิก</th>
                        <th>สถานะ</th>
                        <th>การดำเนินการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var refOrder in pendingRefunds)
                    {
                        <tr>
                            <td class="fw-bold text-primary">#@refOrder.OrderId</td>
                            <td>
                                <div>@refOrder.CustomerName</div>
                                <small class="text-muted">📞 @refOrder.CustomerPhone</small>
                            </td>
                            <td><strong class="text-danger fs-6">฿@refOrder.RefundAmount?.ToString("N2")</strong></td>
                            <td><span class="text-muted small">@refOrder.RefundReason</span></td>
                            <td><span class="badge bg-warning text-dark">รอดำเนินการคืนเงิน</span></td>
                            <td>
                                <form asp-action="ApproveRefund" method="post" onsubmit="return confirm('ยืนยันอนุมัติคืนเงินจำนวน ฿@refOrder.RefundAmount?.ToString("N0") ให้แก่ลูกค้า?');">
                                    <input type="hidden" name="orderId" value="@refOrder.OrderId" />
                                    <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                        <i class="bi bi-check-lg"></i> อนุมัติคืนเงิน
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Payment Status Check (Req 19: บันทึกและตรวจสอบสถานะการชำระเงิน) -->
<div class="card border-0 shadow-sm rounded-4 p-4">
    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-credit-card text-success"></i> ตรวจสอบสถานะการชำระเงินของคำสั่งซื้อล่าสุด (Req 19)</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>เลขออเดอร์</th>
                    <th>วันที่สั่งซื้อ</th>
                    <th>ลูกค้า</th>
                    <th>ยอดชำระ</th>
                    <th>วิธีชำระ</th>
                    <th>สถานะการเงิน</th>
                    <th>สถานะคำสั่งซื้อ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="fw-bold">#@order.OrderId</td>
                        <td><small class="text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td>@order.CustomerName</td>
                        <td class="fw-bold text-dark">฿@order.GrandTotal.ToString("N2")</td>
                        <td><span class="badge bg-light text-dark border">@order.PaymentMethod</span></td>
                        <td>
                            @if (order.Status == OrderStatus.Refunded)
                            {
                                <span class="badge bg-secondary">คืนเงินแล้ว</span>
                            }
                            else if (order.IsPaymentApproved)
                            {
                                <span class="badge bg-success">ชำระเงินเรียบร้อย</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">รอตรวจสอบสลิป</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@order.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
